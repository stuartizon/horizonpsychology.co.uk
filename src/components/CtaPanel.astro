---
// Invites visitors to book the free introductory call.
import Button from "./Button.astro";
---

<section class="cta-panel">
  <div class="cta-panel__text">
    <h2>Start with a free 15-minute call</h2>
    <p>A short, no-obligation conversation to ask questions and see whether working together feels right.</p>
  </div>
  <div class="cta-panel__action">
    <Button href="/contact/" label="Book a free call" />
  </div>
</section>

<style>
  /* Wraps the button under the text when there isn't room for both side by side. */
  .cta-panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(28px, 5vw, 64px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--color-panel);
    padding: var(--panel-pad);
    box-shadow: var(--shadow-rest);
  }

  .cta-panel__text {
    display: flex;
    min-width: 0;
    flex: 1 1 380px;
    flex-direction: column;
    gap: 14px;
  }

  p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .cta-panel__action {
    flex: 0 0 auto;
  }
</style>
