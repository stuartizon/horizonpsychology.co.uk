---
// Invites visitors to book the free introductory call.
import Button from "./Button.astro";
---

<section class="cta-panel">
  <div class="cta-panel__text">
    <h2>Start with a free 15-minute call</h2>
    <p>A chance to ask any questions and decide whether we're the right fit, with no obligation to go further.</p>
  </div>
  <Button href="/contact/" label="Get in touch" />
</section>

<style>
  .cta-panel {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: var(--space-6);
    border-radius: var(--radius-panel);
    background: var(--color-cream);
    padding: var(--panel-pad);
  }

  .cta-panel__text {
    display: flex;
    max-width: var(--measure-prose);
    flex-direction: column;
    gap: var(--space-3);
  }

  p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  @media (min-width: 48rem) {
    .cta-panel {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: var(--space-10);
    }
  }
</style>
