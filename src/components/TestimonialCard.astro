---
import StarRating from "./StarRating.astro";

interface Props {
  quote: string;
  name: string;
}

const { quote, name } = Astro.props;
---

<figure class="testimonial-card">
  <blockquote class="testimonial-card__quote">
    <p>&ldquo;{quote}&rdquo;</p>
  </blockquote>
  <StarRating />
  <figcaption class="testimonial-card__name">{name}</figcaption>
</figure>

<style>
  .testimonial-card {
    display: grid;
    align-content: center;
    justify-items: center;
    gap: 16px;
    margin: 0;
    border: 1px solid var(--color-testimonial-border);
    border-radius: 8px;
    background: var(--color-testimonial-surface);
    padding: 32px clamp(20px, 5vw, 56px);
    text-align: center;
  }

  .testimonial-card__quote {
    margin: 0;
    color: var(--color-grey-600);
    font-family: "Lora", Georgia, "Times New Roman", serif;
    font-size: 1.3rem;
    font-style: italic;
    line-height: 1.4;
  }

  .testimonial-card__quote p {
    margin: 0;
  }

  .testimonial-card__name {
    color: var(--color-service-heading);
    font-weight: 700;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .testimonial-card {
      padding: 24px 20px;
    }

    .testimonial-card__quote {
      font-size: 1.1rem;
    }
  }
</style>
