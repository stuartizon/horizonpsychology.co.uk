---
// A short label in small capitals above a heading or a group of links.
---

<span class="eyebrow">
  <slot />
</span>

<style>
  .eyebrow {
    color: var(--color-sage-600);
    font-size: 0.78rem;
    font-weight: var(--weight-semibold);
    letter-spacing: 0.14em;
    line-height: var(--leading-tight);
    text-transform: uppercase;
  }
</style>
