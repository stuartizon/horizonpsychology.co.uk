---
// On the privacy policy, a switch for whether this browser's visits are
// counted. It only works with JavaScript, so it's a template, which its script
// adds to the end of the section on cookies and website usage. It's only shown
// where visits are counted.
import Switch from "./Switch.astro";
---

<template class="visit-counting-template">
  <Switch
    id="count-visits"
    class="visit-counting"
    label="Count my visits to this website"
  />
</template>

<script>
  import {
    askedNotToTrack,
    countsVisits,
    optedOut,
    setOptedOut,
  } from "@/analytics";

  const template = document.querySelector<HTMLTemplateElement>(
    ".visit-counting-template",
  );
  const out = optedOut();
  const headings = [...document.querySelectorAll("h2")];
  const section = headings.findIndex(({ id }) =>
    id.endsWith("cookies-and-website-usage"),
  );
  const next = headings[section + 1];
  // Without local storage, the switch couldn't change anything.
  if (countsVisits() && template && out !== undefined && section >= 0 && next) {
    const control = template.content.firstElementChild!.cloneNode(
      true,
    ) as HTMLElement;
    const toggle = control.querySelector("button")!;
    const hint = control.querySelector(".switch__hint")!;

    const show = (counted: boolean) => {
      toggle.setAttribute("aria-checked", String(counted));
      hint.textContent = counted
        ? "Your visits are counted anonymously. No cookies or personal details are stored."
        : "Your visits aren’t counted on this browser.";
    };

    if (askedNotToTrack()) {
      toggle.disabled = true;
      hint.textContent =
        "Your browser asks websites not to track you, so your visits aren’t counted.";
    } else {
      show(!out);
      toggle.addEventListener("click", () => {
        const counted = toggle.getAttribute("aria-checked") !== "true";
        setOptedOut(!counted);
        show(counted);
      });
    }

    next.before(control);
  }
</script>
