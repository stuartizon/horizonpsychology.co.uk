---
interface Props {
  href: string;
  label: string;
  type?: "primary" | "secondary" | "link";
}

const { href, label, type = "primary" } = Astro.props;
---

<a class:list={["button", `button--${type}`]} href={href}>
  {label}
</a>

<style>
  .button {
    display: inline-flex;
    min-height: 46px;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    padding: 12px 26px;
    font-size: 1rem;
    font-weight: var(--weight-semibold);
    line-height: 1.2;
    letter-spacing: 0.005em;
    text-decoration: none;
    white-space: nowrap;
    transition: var(--transition-quiet);
  }

  .button--primary,
  .button--primary:hover {
    color: var(--color-panel);
  }

  .button--primary {
    background: var(--color-sage-600);
  }

  .button--primary:hover {
    background: var(--color-sage-800);
  }

  .button--secondary {
    border-color: var(--color-sage-300);
    background: transparent;
    color: var(--color-sage-800);
  }

  .button--secondary:hover {
    border-color: var(--color-sage-600);
    background: var(--color-sage-50);
    color: var(--color-sage-800);
  }

  .button--link {
    min-height: 0;
    border: 0;
    background: transparent;
    color: var(--color-sage-600);
    padding: 0;
    text-decoration: underline;
    text-decoration-color: var(--color-sage-300);
    text-underline-offset: 0.18em;
  }

  .button--link:hover {
    color: var(--color-sage-800);
    text-decoration-color: var(--color-sage-800);
  }
</style>
