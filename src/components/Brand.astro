---
// The logo, linking to the home page. Shared by the header, mobile menu and footer, so the
// logo is the same size everywhere and sits in exactly the same place in the header and menu.
import Logo from "./Logo.astro";
---

<a class="brand" href="/" aria-label="Horizon Psychology, home">
  <Logo />
</a>

<style>
  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    height: 20px;
  }

  @media (min-width: 48rem) {
    .brand {
      height: 24px;
    }
  }
</style>
