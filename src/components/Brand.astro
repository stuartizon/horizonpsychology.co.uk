---
// The logo, linking to the home page. Shared by the header and the mobile menu
// so the logo sits in exactly the same place in both.
---

<a class="brand" href="/" aria-label="Horizon Psychology, home">
  <img src="/images/brand.png" alt="" width="38" height="38" />
</a>

<style>
  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 28%;
    background: var(--color-sage-50);
  }

  img {
    display: block;
    width: 38px;
    height: 38px;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.4);
  }
</style>
