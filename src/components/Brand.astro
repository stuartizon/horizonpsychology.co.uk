---
// The logo, linking to the home page. Shared by the header, mobile menu and footer, so the
// logo is the same size everywhere and sits in exactly the same place in the header and menu.
//
// With `full`, it shows the full lockup in a box the size of the wordmark, with the lockup's
// HORIZON exactly over where the wordmark would be. The home page header scales and moves it
// with --logo-scale and --logo-shift, which change only how it's drawn, not the layout.
import Logo from "./Logo.astro";

interface Props {
  full?: boolean;
}

const { full = false } = Astro.props;
---

<a
  class:list={["brand", { "brand--full": full }]}
  href="/"
  aria-label="Horizon Psychology, home"
>
  <Logo variant={full ? "full" : "wordmark"} />
</a>

<style>
  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    height: 20px;
  }

  /* The wordmark's proportions, from its viewBox. */
  .brand--full {
    position: relative;
    aspect-ratio: 248.7 / 34;
  }

  /* The lockup's proportions, from its viewBox: as tall as the wordmark plus PSYCHOLOGY. */
  .brand--full :global(svg) {
    position: absolute;
    top: 0;
    left: 0;
    height: calc(100% * 63.12 / 34);
    transform: translateY(var(--logo-shift, 0px)) scale(var(--logo-scale, 1));
    transform-origin: 0 0;
  }

  /* The focus ring follows the lockup as drawn, not the link's box: it's drawn on a box scaled and
     moved with the SVG, as tall as the visible part of the lockup, so it shrinks onto the wordmark
     as PSYCHOLOGY fades. The ring's sizes are divided by the scale to stay the same as elsewhere. */
  .brand--full:focus-visible {
    outline: none;
    box-shadow: none;
  }

  .brand--full::after {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: calc(100% * (34 + 29.12 * var(--logo-sub-opacity, 1)) / 34);
    border-radius: calc(4px / var(--logo-scale, 1));
    transform: translateY(var(--logo-shift, 0px)) scale(var(--logo-scale, 1));
    transform-origin: 0 0;
    pointer-events: none;
    content: "";
  }

  .brand--full:focus-visible::after {
    outline: calc(2px / var(--logo-scale, 1)) solid var(--color-sage-600);
    outline-offset: calc(2px / var(--logo-scale, 1));
    box-shadow: 0 0 0 calc(5px / var(--logo-scale, 1))
      color-mix(in srgb, var(--color-sage-600) 16%, transparent);
  }

  @media (min-width: 48rem) {
    .brand {
      height: 24px;
    }
  }
</style>
