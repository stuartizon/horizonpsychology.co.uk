---
// The logo, linking to the home page. Shared by the header, mobile menu and footer, so the
// logo sits in exactly the same place in the header and the menu.
import Logo from "./Logo.astro";

interface Props {
  size?: "header" | "footer";
}

const { size = "header" } = Astro.props;
---

<a class:list={["brand", `brand--${size}`]} href="/" aria-label="Horizon Psychology, home">
  <Logo />
</a>

<style>
  .brand {
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    height: 20px;
  }

  .brand--footer {
    height: 22px;
  }

  @media (min-width: 48rem) {
    .brand--header {
      height: 24px;
    }
  }
</style>
