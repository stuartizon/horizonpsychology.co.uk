---
// A link that opens in a new tab, usually to another site: an arrow shows it,
// and screen readers are told.
import arrowIcon from "@phosphor-icons/core/regular/arrow-up-right.svg?raw";
import "./ExternalLink.css";

interface Props {
  href: string;
  label: string;
}

const { href, label } = Astro.props;
// The last word goes with the arrow, so the arrow never wraps on its own.
const start = label.slice(0, label.lastIndexOf(" ") + 1);
const end = label.slice(start.length);
---

<a href={href} target="_blank" rel="noopener">
  {start}
  <span class="external-link__end">
    {end}
    <span class="external-link__icon" aria-hidden="true" set:html={arrowIcon} />
  </span>
  <span class="visually-hidden"> (opens in a new tab)</span>
</a>
