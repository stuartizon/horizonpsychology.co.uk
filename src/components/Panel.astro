---
// A box set apart from the page: white with a border, sage or amber. It's only
// a look; what the panel is for belongs to the component that uses it.
interface Props {
  variant: "white" | "sage" | "amber";
}

const { variant } = Astro.props;
---

<div class:list={["panel", `panel--${variant}`]}>
  <slot />
</div>

<style>
  .panel {
    border-radius: var(--radius-panel);
    padding: var(--panel-pad);
  }

  .panel--white {
    border: 1px solid var(--color-line);
    background: var(--color-panel);
    box-shadow: var(--shadow-rest);
  }

  .panel--sage {
    background: var(--color-sage-50);
  }

  .panel--amber {
    border: 1px solid var(--color-amber-300);
    background: var(--color-amber-100);
    color: var(--color-amber-800);
  }
</style>
