---
import {
  about,
  contact,
  faqs,
  informationLinks,
  research,
  serviceLinks,
} from "@/data/navigation";
import { CONTACT_EMAIL, SITE_TITLE } from "@/consts";
import Brand from "./Brand.astro";
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";

const email = CONTACT_EMAIL;
// The year the site was built, which the script updates to the current year.
const year = new Date().getFullYear();

const groups = [
  { title: "Work together", links: serviceLinks },
  { title: "About Horizon", links: [about, research, faqs, contact] },
  { title: "Information", links: informationLinks, wide: true },
];
---

<footer class="footer">
  <Container>
    <div class="footer__grid">
      <div class="footer__about">
        <Brand />
        <p>
          Psychological therapy, clinical and research supervision. Online, and
          face-to-face in Buckinghamshire.
        </p>
        <a class="footer__email" href={`mailto:${email}`}>
          {email}
        </a>
      </div>
      {groups.map((group) => (
        <nav
          class:list={["footer__group", { "footer__group--wide": group.wide }]}
          aria-label={group.title}
        >
          <Eyebrow>{group.title}</Eyebrow>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="footer__copyright">
      © <span data-current-year>{year}</span> {SITE_TITLE}
    </p>
  </Container>
</footer>

<script>
  const year = document.querySelector("[data-current-year]");
  if (year) year.textContent = String(new Date().getFullYear());
</script>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-cream);
    padding-block: var(--section-y-tight) var(--space-8);
    font-size: var(--text-small);
  }

  /* On a phone the link groups fit two to a row once there's room, which is from about 352px. */
  .footer__grid,
  .footer__group--wide ul {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 9rem), 1fr));
    column-gap: var(--space-6);
  }

  .footer__grid {
    row-gap: var(--space-8);
  }

  .footer__about,
  .footer__group--wide {
    grid-column: 1 / -1;
  }

  .footer__about {
    display: flex;
    max-width: 34ch;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .footer__about p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .footer__email {
    overflow-wrap: anywhere;
  }

  .footer__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__group a {
    display: inline-block;
    min-height: 24px;
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .footer__group a:hover {
    color: var(--color-sage-800);
  }

  .footer__copyright {
    margin: 28px 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-caption);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px var(--space-8);
    }

    .footer__group--wide {
      grid-column: auto;
    }

    ul,
    .footer__group--wide ul {
      display: flex;
      gap: 9px;
    }

    .footer__group a {
      min-height: 0;
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(140px, 1fr));
    }

    .footer__about {
      grid-column: auto;
    }
  }
</style>
