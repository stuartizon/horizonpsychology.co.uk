---
import {
  about,
  contact,
  faqs,
  informationLinks,
  research,
  serviceLinks,
} from "@/data/navigation";
import { CONTACT_EMAIL, SITE_TITLE } from "@/consts";
import Brand from "./Brand.astro";
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";

const email = CONTACT_EMAIL;
// The year the site was built, which the script updates to the current year.
const year = new Date().getFullYear();

const groups = [
  { title: "Work together", links: serviceLinks },
  { title: "About Horizon", links: [about, research, faqs, contact] },
  { title: "Information", links: informationLinks },
];
---

<footer class="footer">
  <Container>
    <div class="footer__grid">
      <div class="footer__about">
        <Brand />
        <p>
          Psychological therapy, clinical and research supervision. Online, and
          face-to-face in Buckinghamshire.
        </p>
        <a class="footer__email" href={`mailto:${email}`}>
          {email}
        </a>
      </div>
      {groups.map((group) => (
        <nav class="footer__group" aria-label={group.title}>
          <div class="footer__heading">
            <Eyebrow>{group.title}</Eyebrow>
          </div>
          <ul>
            {group.links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </nav>
      ))}
    </div>
    <p class="footer__copyright">
      © <span data-current-year>{year}</span> {SITE_TITLE}
    </p>
  </Container>
</footer>

<script>
  const year = document.querySelector("[data-current-year]");
  if (year) year.textContent = String(new Date().getFullYear());
</script>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-cream);
    padding-block: var(--section-y-tight) var(--space-8);
    font-size: var(--text-small);
  }

  /* On a phone the link groups run together as one list, without their headings. Each nav
     keeps its name from aria-label. */
  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-3);
  }

  .footer__about {
    display: flex;
    margin-bottom: var(--space-5);
    max-width: 34ch;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .footer__about p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .footer__email {
    overflow-wrap: anywhere;
  }

  .footer__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .footer__heading {
    display: none;
  }

  /* On a phone the links sit in two equal columns once there's room for two 9rem
     columns, from about 352px, and in one column below that. */
  ul {
    --gap: var(--space-6);

    display: grid;
    grid-template-columns: repeat(
      auto-fit,
      minmax(min(100%, max(9rem, (100% - var(--gap)) / 2)), 1fr)
    );
    gap: var(--space-3) var(--gap);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__group a {
    display: inline-block;
    min-height: 24px;
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .footer__group a:hover {
    color: var(--color-sage-800);
  }

  .footer__copyright {
    margin: 28px 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-caption);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px var(--space-8);
    }

    .footer__about {
      grid-column: 1 / -1;
      margin-bottom: 0;
    }

    /* The eyebrow lays out as if the wrapper weren't there. */
    .footer__heading {
      display: contents;
    }

    ul {
      display: flex;
      flex-direction: column;
      gap: 9px;
    }

    .footer__group a {
      min-height: 0;
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(140px, 1fr));
    }

    .footer__about {
      grid-column: auto;
    }
  }
</style>
