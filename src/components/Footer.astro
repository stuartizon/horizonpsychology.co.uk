---
import { about, contact, faqs, practicalLinks, research, serviceLinks } from "@/data/navigation";
import Brand from "./Brand.astro";
import Container from "./Container.astro";
import Eyebrow from "./Eyebrow.astro";

const email = "hello@horizonpsychology.co.uk";

const groups = [
  { title: "Work together", links: serviceLinks },
  { title: "Practice", links: [about, research, faqs, contact] },
  { title: "Practical", links: practicalLinks },
];
---

<footer class="footer">
  <Container>
    <div class="footer__grid">
      <div class="footer__about">
        <Brand />
        <p>Psychological therapy, clinical and research supervision. Online, and face-to-face in Buckinghamshire.</p>
        <a class="footer__email" href={`mailto:${email}`}>{email}</a>
      </div>
      {
        groups.map((group) => (
          <nav class="footer__group" aria-label={group.title}>
            <Eyebrow>{group.title}</Eyebrow>
            <ul>
              {group.links.map((link) => (
                <li>
                  <a href={link.href}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>
    <p class="footer__note">
      Dr Emma Izon is registered with the Health and Care Professions Council and accredited by the BABCP. Therapy is
      not an emergency service: if you need support today, contact your GP or call NHS 111.
    </p>
  </Container>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-line);
    background: var(--color-cream);
    padding-block: clamp(36px, 5vw, 64px) var(--space-8);
    font-size: var(--text-small);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }

  .footer__about {
    display: flex;
    max-width: 34ch;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .footer__about p {
    margin: 0;
    color: var(--color-ink-soft);
  }

  .footer__email {
    overflow-wrap: anywhere;
  }

  .footer__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer__group a {
    display: inline-block;
    min-height: 24px;
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .footer__group a:hover {
    color: var(--color-sage-800);
  }

  /* The export uses the faintest ink here, which is too low in contrast on cream. */
  .footer__note {
    max-width: 70ch;
    margin: 28px 0 0;
    color: var(--color-ink-soft);
    font-size: var(--text-caption);
  }

  @media (min-width: 48rem) {
    .footer__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 36px var(--space-8);
    }

    .footer__about {
      grid-column: 1 / -1;
    }

    ul {
      gap: 9px;
    }

    .footer__group a {
      min-height: 0;
    }
  }

  @media (min-width: 64rem) {
    .footer__grid {
      grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(140px, 1fr));
    }

    .footer__about {
      grid-column: auto;
    }
  }
</style>
