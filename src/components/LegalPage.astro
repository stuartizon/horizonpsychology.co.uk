---
// The body of a legal or practical page, such as the confidentiality statement.
import { CONTACT_EMAIL } from "@/consts";
import Container from "./Container.astro";
import FeeList from "./FeeList.astro";
import SectionHeading from "./SectionHeading.astro";

interface Props {
  title: string;
  lead: string;
  /** Shows a note that the wording isn't final. */
  draft: boolean;
  /** Lists each service's fee after the lead. */
  fees?: boolean;
}

const { title, lead, draft, fees = false } = Astro.props;
---

<Container>
  <article class="legal-page">
    <div class="legal-page__heading">
      <SectionHeading eyebrow="Practical" title={title} level="h1" />
      {draft && <p class="legal-page__note">Draft — to be confirmed</p>}
    </div>
    <div class="legal-page__body">
      <p>{lead}</p>
      {fees && <FeeList />}
      <slot />
      <p class="legal-page__note">
        Questions about this page can go to{" "}
        <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>.
      </p>
    </div>
  </article>
</Container>

<style>
  .legal-page {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
    padding-block: var(--section-y-tight) var(--section-y);
  }

  .legal-page__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .legal-page__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  p,
  .legal-page__body :global(p) {
    margin: 0;
  }

  .legal-page__note {
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }
</style>
