---
// The HORIZON wordmark: the amber sun as the first O, rising over its horizon line, with IZON
// in amber. The letters are outlines of Lora, so the sun sits exactly in the O whether or not
// the font has loaded. The gradient spans the whole sun, of which only the part above the
// horizon shows. Each logo gets its own gradient id, as there's more than one on a page.
const id = `logo-sun-${crypto.randomUUID().slice(0, 8)}`;
