---
// Sets the width shared by the header, footer and page content: at most
// --content-max-width, with a --gutter either side at every width.
---

<div class="container">
  <slot />
</div>

<style>
  .container {
    max-width: calc(var(--content-max-width) + var(--gutter) * 2);
    margin-inline: auto;
    padding-inline: var(--gutter);
  }
</style>
