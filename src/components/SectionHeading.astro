---
// An eyebrow and a heading, at the top of a page or section.
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow: string;
  title: string;
  /** h1 for a page's intro, h2 for a section. */
  level?: "h1" | "h2";
  /** An id for the heading, so a section can be labelled by it. */
  id?: string;
}

const { eyebrow, title, level: Heading = "h2", id } = Astro.props;
---

<hgroup class="section-heading">
  <p><Eyebrow>{eyebrow}</Eyebrow></p>
  <Heading id={id}>{title}</Heading>
</hgroup>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  p,
  h1,
  h2 {
    margin: 0;
  }

  /* So the paragraph is only as tall as the eyebrow, not a line of body text. */
  p {
    display: flex;
  }
</style>
