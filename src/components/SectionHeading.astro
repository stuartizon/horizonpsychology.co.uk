---
// A heading, with an optional eyebrow and subtitle, at the top of a page or section.
import Eyebrow from "./Eyebrow.astro";

interface Props {
  eyebrow?: string;
  title: string;
  /** h1 for a page's intro, h2 for a section. */
  level?: "h1" | "h2";
  /** An id for the heading, so a section can be labelled by it. */
  id?: string;
  /** A short line after the heading, such as a person's credentials. */
  subtitle?: string;
}

const { eyebrow, title, level: Heading = "h2", id, subtitle } = Astro.props;
---

<hgroup class="section-heading">
  {eyebrow && (
    <p class="section-heading__eyebrow">
      <Eyebrow>{eyebrow}</Eyebrow>
    </p>
  )}
  <Heading id={id}>{title}</Heading>
  {subtitle && <p class="section-heading__subtitle">{subtitle}</p>}
</hgroup>

<style>
  .section-heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  p,
  h1,
  h2 {
    margin: 0;
  }

  /* So the paragraph is only as tall as the eyebrow, not a line of body text. */
  .section-heading__eyebrow {
    display: flex;
  }

  .section-heading__subtitle {
    color: var(--color-ink-soft);
    font-size: var(--text-lead);
  }
</style>
