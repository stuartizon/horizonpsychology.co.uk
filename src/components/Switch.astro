---
// An on/off switch: a button with role="switch", named by its label, and a
// hint beside it that says what the state means. Only the hint is shown, as it
// changes with the switch. It's drawn off; a script sets aria-checked, which
// moves the thumb, and sets the hint, which is announced when it changes.
interface Props {
  id: string;
  label: string;
  class?: string;
}

const { id, label, class: className } = Astro.props;
---

<div class:list={["switch", className]}>
  <button
    id={id}
    class="switch__track"
    type="button"
    role="switch"
    aria-checked="false"
    aria-label={label}
    aria-describedby={`${id}-hint`}
  >
    <span class="switch__thumb" aria-hidden="true"></span>
  </button>
  <span class="switch__hint" id={`${id}-hint`} aria-live="polite"></span>
</div>

<style>
  .switch {
    /* An even ease, rather than the site's quick ease-out, so the thumb
       slides across instead of jumping most of the way at once. */
    --switch-motion: 180ms ease;
    display: flex;
    max-width: 100%;
    align-items: flex-start;
    gap: var(--space-3);
  }

  .switch__track {
    position: relative;
    flex: none;
    width: 44px;
    height: 26px;
    border: 1px solid var(--color-line-strong);
    border-radius: var(--radius-pill);
    padding: 0;
    background: var(--color-panel);
    cursor: pointer;
    transition:
      background-color var(--switch-motion),
      border-color var(--switch-motion);
  }

  .switch__track:focus-visible {
    border-radius: var(--radius-pill);
  }

  .switch__thumb {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    /* Off, the dark thumb gives the switch 3:1 contrast against the page. */
    background: var(--color-ink-soft);
    transition:
      transform var(--switch-motion),
      background-color var(--switch-motion);
  }

  .switch__track[aria-checked="true"] {
    border-color: var(--color-sage-600);
    background: var(--color-sage-600);
  }

  .switch__track[aria-checked="true"] .switch__thumb {
    background: var(--color-panel);
    transform: translateX(18px);
  }

  .switch__track:hover:not(:disabled) {
    border-color: var(--color-ink);
  }

  .switch__track[aria-checked="true"]:hover:not(:disabled) {
    border-color: var(--color-sage-800);
    background: var(--color-sage-800);
  }

  /* Disabled, it's drawn off in paler greys, and the hint stays full
     contrast, so the reason can be read. */
  .switch__track:disabled {
    border-color: var(--color-line);
    cursor: not-allowed;
  }

  .switch__track:disabled .switch__thumb {
    background: var(--color-line-strong);
  }

  .switch__hint {
    min-width: 0;
    /* Centres a line of the hint on the track. */
    padding-top: 1px;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
    line-height: 1.55;
    text-wrap: pretty;
  }

  .switch__hint:empty {
    display: none;
  }
</style>
