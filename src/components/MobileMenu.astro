---
import type { Link } from "@/data/navigation";
import closeIcon from "@phosphor-icons/core/regular/x.svg?raw";
import Brand from "./Brand.astro";
import Container from "./Container.astro";

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<dialog id="mobile-menu" class="menu" aria-label="Menu" data-mobile-menu>
  <div class="menu__top">
    <Container>
      <div class="menu__bar">
        <Brand />
        <button class="menu__close" type="button" aria-label="Close menu" data-mobile-menu-close>
          <span class="menu__close-icon" aria-hidden="true" set:html={closeIcon} />
        </button>
      </div>
    </Container>
  </div>
  <Container>
    <nav aria-label="Menu">
      <ul>
        {
          links.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
  </Container>
</dialog>

<script>
  const menu = document.querySelector<HTMLDialogElement>("[data-mobile-menu]")!;
  const opener = document.querySelector<HTMLButtonElement>(`[aria-controls="${menu.id}"]`)!;
  const focusable = () => [...menu.querySelectorAll<HTMLElement>("a, button")];

  opener.addEventListener("click", () => {
    menu.showModal();
    opener.setAttribute("aria-expanded", "true");
    menu.querySelector<HTMLElement>("[data-mobile-menu-close]")!.focus();
  });

  menu.querySelector("[data-mobile-menu-close]")!.addEventListener("click", () => menu.close());

  // Closing by any route (the close button, Escape) returns focus to the menu button.
  menu.addEventListener("close", () => {
    opener.setAttribute("aria-expanded", "false");
    opener.focus();
  });

  // Tab and Shift+Tab wrap around inside the menu instead of leaving it.
  menu.addEventListener("keydown", (event) => {
    if (event.key !== "Tab") return;
    const elements = focusable();
    const [first, last] = [elements[0], elements[elements.length - 1]];
    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  });

  // From tablet width the header shows the full navigation, so the menu isn't needed.
  // Matches the tablet breakpoint (ADR 0014).
  matchMedia("(min-width: 48rem)").addEventListener("change", (event) => {
    if (event.matches && menu.open) menu.close();
  });
</script>

<style>
  .menu {
    position: fixed;
    inset: 0;
    width: auto;
    max-width: none;
    height: auto;
    max-height: none;
    margin: 0;
    border: 0;
    background: var(--color-background);
    padding: 0;
    color: var(--color-ink);
    overflow-y: auto;
  }

  .menu::backdrop {
    background: var(--color-background);
  }

  /* Stop the page behind the menu from scrolling. */
  :global(html:has(.menu[open])) {
    overflow: hidden;
  }

  .menu__bar {
    display: flex;
    min-height: 66px;
    align-items: center;
    justify-content: space-between;
  }

  /* Matches the header's bottom border, across the full width. */
  .menu__top {
    border-bottom: 1px solid var(--color-line);
  }

  .menu__close {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    /* The icon has space around it inside the 44px button, so pull it out to line up with the page margin. */
    margin-right: -14px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--color-sage-800);
    padding: 0;
    cursor: pointer;
  }

  .menu__close-icon {
    display: block;
    width: 24px;
  }

  .menu__close-icon :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    margin: 0;
    padding: var(--space-1) 0 var(--space-2);
    list-style: none;
  }

  li {
    border-bottom: 1px solid var(--color-line);
  }

  nav a {
    display: block;
    padding-block: 18px;
    color: var(--color-sage-800);
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: var(--leading-display);
    text-decoration: none;
  }

  nav a:hover {
    color: var(--color-sage-600);
  }

  @media (min-width: 48rem) {
    .menu {
      display: none;
    }
  }
</style>
