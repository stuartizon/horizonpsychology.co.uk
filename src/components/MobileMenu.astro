---
import Button from "./Button.astro";
import closeIcon from "../icons/close.svg?raw";

interface NavItem {
  label: string;
  href: string;
}

interface Props {
  navItems: NavItem[];
}

const { navItems } = Astro.props;
---

<div
  id="mobile-menu"
  class="mobile-menu"
  role="dialog"
  aria-modal="true"
  aria-label="Mobile navigation menu"
  data-mobile-menu
  hidden
>
  <div class="mobile-menu__bar">
    <a class="mobile-menu__brand" href="/" aria-label="Emma home">EMMA</a>
    <div class="mobile-menu__actions">
      <Button href="/schedule/" label="Schedule" type="primary" />
      <button
        class="mobile-menu__close"
        type="button"
        aria-label="Close menu"
        data-mobile-menu-close
      >
        <span class="mobile-menu__close-icon" aria-hidden="true" set:html={closeIcon}></span>
      </button>
    </div>
  </div>

  <nav class="mobile-menu__nav" aria-label="Mobile navigation">
    <ul>
      {navItems.map((item) => (
        <li>
          <a href={item.href}>{item.label}</a>
        </li>
      ))}
      <li>
        <a href="/schedule/">Schedule</a>
      </li>
    </ul>
  </nav>
</div>

<script>
  const menu = document.querySelector("[data-mobile-menu]");
  const openButtons = document.querySelectorAll("[data-mobile-menu-open]");
  const closeButton = document.querySelector("[data-mobile-menu-close]");

  let previousBodyOverflow = "";
  let previousHtmlOverflow = "";
  let previouslyFocusedElement: Element | null = null;

  function openMenu() {
    if (!(menu instanceof HTMLElement)) return;

    previouslyFocusedElement = document.activeElement;
    previousBodyOverflow = document.body.style.overflow;
    previousHtmlOverflow = document.documentElement.style.overflow;
    document.body.style.overflow = "hidden";
    document.documentElement.style.overflow = "hidden";
    menu.hidden = false;

    openButtons.forEach((button) => {
      button.setAttribute("aria-expanded", "true");
    });
    if (closeButton instanceof HTMLElement) {
      closeButton.focus();
    }
  }

  function closeMenu() {
    if (!(menu instanceof HTMLElement)) return;

    menu.hidden = true;
    document.body.style.overflow = previousBodyOverflow;
    document.documentElement.style.overflow = previousHtmlOverflow;

    openButtons.forEach((button) => {
      button.setAttribute("aria-expanded", "false");
    });
    if (previouslyFocusedElement instanceof HTMLElement) {
      previouslyFocusedElement.focus();
    }
  }

  openButtons.forEach((button) => {
    button.addEventListener("click", openMenu);
  });

  closeButton?.addEventListener("click", closeMenu);
</script>

<style>
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 20;
    display: flex;
    flex-direction: column;
    background: var(--color-service-surface);
  }

  .mobile-menu[hidden] {
    display: none;
  }

  .mobile-menu__bar {
    display: grid;
    min-height: 94px;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 18px;
    border-bottom: 1px solid var(--color-nav-border);
    background: var(--color-nav-surface);
    padding: 18px 22px;
  }

  .mobile-menu__brand {
    color: var(--color-grey-800);
    font-size: 1.55rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-menu__actions {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  .mobile-menu__close {
    display: inline-flex;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--color-nav-menu);
    padding: 0;
    cursor: pointer;
  }

  .mobile-menu__close-icon {
    display: block;
    width: 29px;
  }

  .mobile-menu__close-icon :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  .mobile-menu__nav {
    flex: 1;
    overflow-y: auto;
    background: var(--color-button-surface);
    padding: 110px 28px 48px;
  }

  .mobile-menu__nav ul {
    display: grid;
    gap: 34px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: center;
  }

  .mobile-menu__nav a {
    color: var(--color-panel);
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.1;
    text-decoration: none;
    text-transform: uppercase;
  }

  .mobile-menu__nav a:hover {
    color: var(--color-panel);
  }

  @media (min-width: 761px) {
    .mobile-menu {
      display: none;
    }
  }

  @media (max-width: 430px) {
    .mobile-menu__bar {
      padding-inline: 16px;
    }

    .mobile-menu__brand {
      font-size: 1.25rem;
    }

    .mobile-menu__actions {
      gap: 10px;
    }

    .mobile-menu__nav {
      padding-top: 82px;
    }

    .mobile-menu__nav a {
      font-size: 1.35rem;
    }
  }
</style>
