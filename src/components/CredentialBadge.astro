---
interface Props {
  label: string;
  tooltip: string;
}

const { label, tooltip } = Astro.props;
---

<button type="button" class="credential-badge" aria-label={tooltip}>
  {label}
  <span class="credential-badge__tooltip" aria-hidden="true">{tooltip}</span>
</button>

<style>
  .credential-badge {
    position: relative;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--color-grey-50);
    border-radius: 999px;
    background: rgba(159, 159, 159, 0.15);
    padding: 6px 14px;
    font: inherit;
    color: var(--color-grey-800);
    font-size: 0.78rem;
    font-weight: 600;
    line-height: 1.25;
    cursor: default;
    -webkit-appearance: none;
    appearance: none;
  }

  .credential-badge__tooltip {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;
    z-index: 10;
    width: max-content;
    max-width: 220px;
    transform: translateX(-50%) translateY(4px);
    transition:
      opacity 150ms ease,
      transform 150ms ease;
    border-radius: 8px;
    background: var(--color-grey-600);
    padding: 8px 12px;
    color: var(--color-panel);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1.3;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }

  .credential-badge__tooltip::after {
    content: "";
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    border: 5px solid transparent;
    border-top-color: var(--color-grey-600);
  }

  .credential-badge:hover .credential-badge__tooltip,
  .credential-badge:focus-visible .credential-badge__tooltip {
    transform: translateX(-50%) translateY(0);
    opacity: 1;
  }

  .credential-badge:first-child .credential-badge__tooltip {
    left: 0;
    transform: translateY(4px);
  }

  .credential-badge:first-child .credential-badge__tooltip::after {
    left: 16px;
    transform: none;
  }

  .credential-badge:first-child:hover .credential-badge__tooltip,
  .credential-badge:first-child:focus-visible .credential-badge__tooltip {
    transform: translateY(0);
  }

  .credential-badge:last-child .credential-badge__tooltip {
    left: auto;
    right: 0;
    transform: translateY(4px);
  }

  .credential-badge:last-child .credential-badge__tooltip::after {
    left: auto;
    right: 16px;
    transform: none;
  }

  .credential-badge:last-child:hover .credential-badge__tooltip,
  .credential-badge:last-child:focus-visible .credential-badge__tooltip {
    transform: translateY(0);
  }

  @media (hover: none) {
    .credential-badge:focus .credential-badge__tooltip {
      transform: translateX(-50%) translateY(0);
      opacity: 1;
    }

    .credential-badge:first-child:focus .credential-badge__tooltip {
      transform: translateY(0);
    }

    .credential-badge:last-child:focus .credential-badge__tooltip {
      transform: translateY(0);
    }
  }
</style>
