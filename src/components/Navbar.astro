---
import Button from "./Button.astro";
import burgerIcon from "../icons/burger.svg?raw";
import MobileMenu from "./MobileMenu.astro";

const navItems = [
  { label: "About me", href: "/about/" },
  { label: "Individual Therapy", href: "/individual-therapy/" },
  { label: "Couples Therapy", href: "/couples-therapy/" },
  { label: "Clinical Supervision", href: "/clinical-supervision/" },
  { label: "Research Supervision", href: "/research-supervision/" },
];
---

<header class="navbar">
  <a class="navbar__brand" href="/" aria-label="HorIZON Psychology home">
    <span class="navbar__brand-mark">
      <img src="/images/brand.png" alt="" width="68" height="68" />
    </span>
  </a>
  <nav class="navbar__links" aria-label="Primary navigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="navbar__actions">
    <Button href="/schedule/" label="Schedule" type="primary" />
    <button
      class="navbar__menu"
      type="button"
      aria-label="Open menu"
      aria-controls="mobile-menu"
      aria-expanded="false"
      data-mobile-menu-open
    >
      <span class="navbar__menu-icon" aria-hidden="true" set:html={burgerIcon}></span>
    </button>
  </div>
</header>
<MobileMenu navItems={navItems} />

<style>
  .navbar {
    --nav-gap: clamp(22px, 3vw, 44px);
    display: flex;
    width: 100%;
    min-height: 58px;
    align-items: center;
    gap: var(--nav-gap);
    margin: 0;
    border-bottom: 1px solid var(--color-nav-border);
    background: var(--color-nav-surface);
    padding-block: 12px 13px;
    padding-inline: max(var(--gutter-min), calc((100% - var(--content-max-width)) / 2));
  }

  .navbar__brand {
    display: inline-flex;
    flex: 0 0 auto;
  }

  .navbar__brand-mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    overflow: hidden;
    border-radius: 28%;
    background: var(--color-background);
  }

  .navbar__brand-mark img {
    display: block;
    width: 140%;
    height: 140%;
    object-fit: cover;
    object-position: 50% 30%;
  }

  .navbar__links {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    gap: var(--nav-gap);
    color: var(--color-grey-800);
    font-size: 0.88rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .navbar__links a {
    text-decoration: none;
  }

  .navbar__actions {
    display: flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
    margin-left: auto;
  }

  .navbar__menu {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    border: 0;
    background: transparent;
    color: var(--color-nav-menu);
    padding: 0;
    cursor: pointer;
  }

  .navbar__menu-icon {
    display: block;
    width: 27px;
    height: auto;
  }

  .navbar__menu-icon :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (max-width: 950px) {
    .navbar {
      width: 100%;
      min-height: 94px;
      justify-content: space-between;
      gap: 18px;
      padding-block: 18px;
    }

    .navbar__brand-mark {
      width: 57px;
      height: 57px;
    }

    .navbar__links {
      display: none;
    }

    .navbar__actions {
      gap: 18px;
    }

    .navbar__menu {
      display: inline-flex;
    }
  }

  @media (max-width: 430px) {
    .navbar__actions {
      gap: 10px;
    }
  }
</style>
