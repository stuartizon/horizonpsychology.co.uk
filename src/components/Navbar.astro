---
import { services } from "@/data/services";
import burgerIcon from "@/icons/burger.svg?raw";
import Button from "./Button.astro";
import Container from "./Container.astro";
import MobileMenu from "./MobileMenu.astro";
import ServicesMenu from "./ServicesMenu.astro";

const about = { label: "About Emma", href: "/about/" };
const research = { label: "Research", href: "/projects/" };
const contact = { label: "Contact Us", href: "/contact/" };
const serviceLinks = services.map((service) => ({ label: service.name, href: `/${service.id}/` }));
---

<header class="header">
  <Container>
    <div class="header__bar">
      <a class="header__brand" href="/" aria-label="Horizon Psychology, home">
        <img src="/images/brand.png" alt="" width="38" height="38" />
      </a>
      <nav class="header__nav" aria-label="Primary">
        <a href={about.href}>{about.label}</a>
        <ServicesMenu links={serviceLinks} />
        <a href={research.href}>{research.label}</a>
      </nav>
      <div class="header__contact">
        <Button href={contact.href} label={contact.label} />
      </div>
      <button
        class="header__menu"
        type="button"
        aria-label="Open menu"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-mobile-menu-open
      >
        <span class="header__menu-icon" aria-hidden="true" set:html={burgerIcon} />
      </button>
    </div>
  </Container>
</header>
<MobileMenu links={[about, ...serviceLinks, research, contact]} />

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 15;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-background) 88%, transparent);
    backdrop-filter: blur(8px);
  }

  .header__bar {
    display: flex;
    min-height: 66px;
    align-items: center;
    justify-content: space-between;
    gap: clamp(14px, 3vw, 40px);
  }

  .header__brand {
    display: inline-flex;
    flex: 0 0 auto;
    overflow: hidden;
    border-radius: 28%;
    background: var(--color-sage-50);
  }

  .header__brand img {
    display: block;
    width: 38px;
    height: 38px;
    object-fit: cover;
    object-position: 50% 30%;
    transform: scale(1.4);
  }

  .header__nav,
  .header__contact {
    display: none;
  }

  .header__nav {
    flex: 1;
    align-items: center;
    justify-content: flex-end;
    gap: clamp(14px, 2vw, 32px);
    font-size: var(--text-small);
    font-weight: var(--weight-medium);
    white-space: nowrap;
  }

  .header__nav > a {
    color: var(--color-ink-soft);
    text-decoration: none;
  }

  .header__nav > a:hover {
    color: var(--color-sage-800);
  }

  .header__menu {
    display: inline-flex;
    width: 44px;
    height: 44px;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    border: 0;
    background: transparent;
    color: var(--color-sage-800);
    padding: 0;
    cursor: pointer;
  }

  .header__menu-icon {
    display: block;
    width: 24px;
  }

  .header__menu-icon :global(svg) {
    display: block;
    width: 100%;
    height: auto;
  }

  @media (min-width: 48rem) {
    .header__bar {
      min-height: 76px;
    }

    .header__nav,
    .header__contact {
      display: flex;
    }

    .header__menu {
      display: none;
    }
  }
</style>
