---
import Button from "./Button.astro";

const navItems = [
  { label: "About me", href: "/about/" },
  { label: "Psychological Therapy", href: "/psychological-therapy/" },
  { label: "Couples Psychotherapy", href: "/couples-psychotherapy/" },
  { label: "Clinical Supervision", href: "/clinical-supervision/" },
  { label: "Research Supervision", href: "/research-supervision/" },
];
---

<header class="navbar">
  <a class="navbar__brand" href="/" aria-label="Emma home">EMMA</a>
  <nav class="navbar__links" aria-label="Primary navigation">
    {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <div class="navbar__actions">
    <Button href="/schedule/" label="Schedule" type="primary" />
    <button class="navbar__menu" type="button" aria-label="Open menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>
</header>

<style>
  .navbar {
    display: grid;
    width: 100%;
    min-height: 58px;
    grid-template-columns: minmax(140px, 1fr) auto minmax(140px, 1fr);
    align-items: center;
    gap: 24px;
    margin: 0;
    border-bottom: 1px solid var(--color-nav-border);
    background: var(--color-nav-surface);
    padding: 12px clamp(18px, 4vw, 46px) 13px;
  }

  .navbar__brand {
    color: var(--color-grey-800);
    font-size: 1.02rem;
    font-weight: 800;
    text-decoration: none;
    text-transform: uppercase;
  }

  .navbar__links {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(24px, 4vw, 48px);
    color: var(--color-grey-800);
    font-size: 0.96rem;
    font-weight: 800;
    white-space: nowrap;
  }

  .navbar__links a {
    text-decoration: none;
  }

  .navbar__actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 18px;
  }

  .navbar__menu {
    display: none;
    width: 40px;
    height: 40px;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 6px;
    border: 0;
    background: transparent;
    padding: 0;
    cursor: pointer;
  }

  .navbar__menu span {
    display: block;
    width: 27px;
    height: 3px;
    border-radius: 999px;
    background: var(--color-nav-menu);
  }

  @media (max-width: 760px) {
    .navbar {
      width: 100%;
      min-height: 94px;
      grid-template-columns: 1fr auto;
      gap: 18px;
      padding: 18px 22px;
    }

    .navbar__brand {
      font-size: 1.55rem;
    }

    .navbar__links {
      display: none;
    }

    .navbar__actions {
      gap: 18px;
    }

    .navbar__menu {
      display: inline-flex;
    }
  }

  @media (max-width: 430px) {
    .navbar {
      padding-inline: 16px;
    }

    .navbar__brand {
      font-size: 1.25rem;
    }

    .navbar__actions {
      gap: 10px;
    }

  }
</style>
