---
// An accordion of questions, each opening to show its answer.
import type { Faq } from "@/data/faqs";

interface Props {
  faqs: Faq[];
}

const { faqs } = Astro.props;

// Answer ids come from the question, so lists on the same page don't clash.
const answerId = (question: string) =>
  `faq-${question
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "")}`;
---

<div class="faqs">
  {
    faqs.map(({ question, answer }) => (
      <div class="faq" data-open="false">
        <h3>
          <button type="button" aria-expanded="false" aria-controls={answerId(question)} data-faq-toggle>
            <span class="faq__question">{question}</span>
            <span class="faq__toggle-line" aria-hidden="true">
              <span class="faq__toggle" />
            </span>
          </button>
        </h3>
        <div class="faq__answer" id={answerId(question)}>
          <div class="faq__answer-inner">
            {answer.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </div>
      </div>
    ))
  }
</div>

<script>
  for (const toggle of document.querySelectorAll<HTMLButtonElement>("[data-faq-toggle]")) {
    toggle.addEventListener("click", () => {
      const item = toggle.closest<HTMLElement>(".faq");
      if (!item) return;

      const open = toggle.getAttribute("aria-expanded") !== "true";
      toggle.setAttribute("aria-expanded", String(open));
      item.dataset.open = String(open);
    });
  }
</script>

<style>
  .faqs {
    display: flex;
    flex-direction: column;
  }

  .faq {
    border-bottom: 1px solid var(--color-line);
  }

  .faq:first-child {
    border-top: 1px solid var(--color-line);
  }

  h3 {
    margin: 0;
    font-size: inherit;
  }

  button {
    display: flex;
    width: 100%;
    align-items: baseline;
    gap: clamp(16px, 3vw, 28px);
    border: 0;
    background: transparent;
    padding: 22px 0;
    color: var(--color-sage-800);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 1.22rem;
    font-weight: var(--weight-regular);
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
    text-align: left;
  }

  .faq__question {
    flex: 1;
  }

  /* As tall as a line of the question, so the toggle sits level with the
     first line when the question wraps. */
  .faq__toggle-line {
    display: flex;
    height: 1.3em;
    flex: none;
    align-items: center;
  }

  /* A plus that turns into a cross when the answer is open. */
  .faq__toggle {
    position: relative;
    width: 16px;
    height: 16px;
    transition: transform var(--duration-base) var(--ease-calm);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    position: absolute;
    border-radius: 1px;
    background: var(--color-sage-600);
    content: "";
  }

  .faq__toggle::before {
    top: 7.25px;
    left: 0;
    width: 16px;
    height: 1.5px;
  }

  .faq__toggle::after {
    top: 0;
    left: 7.25px;
    width: 1.5px;
    height: 16px;
  }

  .faq[data-open="true"] .faq__toggle {
    transform: rotate(135deg);
  }

  /* Closed answers are hidden, not just squashed, so they're out of the tab
     order and the accessibility tree. They stay visible while they close. */
  .faq__answer {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows var(--duration-base) var(--ease-calm),
      visibility 0s linear var(--duration-base);
  }

  .faq[data-open="true"] .faq__answer {
    grid-template-rows: 1fr;
    visibility: visible;
    transition: grid-template-rows var(--duration-base) var(--ease-calm);
  }

  .faq__answer-inner {
    min-height: 0;
    overflow: hidden;
  }

  .faq__answer-inner p {
    max-width: var(--measure-prose);
    margin: 0;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }

  .faq__answer-inner p + p {
    margin-top: 0.9em;
  }

  .faq__answer-inner p:last-child {
    padding-bottom: 26px;
  }
</style>
