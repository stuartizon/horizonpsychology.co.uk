---
interface Props {
  label: string;
  interval?: number;
}

const { label, interval = 6000 } = Astro.props;
---

<div
  class="carousel"
  data-carousel
  data-interval={interval}
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div class="carousel__viewport">
    <div class="carousel__track" data-carousel-track>
      <slot />
    </div>
  </div>
  <div class="carousel__dots" data-carousel-dots role="tablist" aria-label="Choose slide"></div>
</div>

<script>
  const prefersReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelectorAll("[data-carousel]").forEach((carousel) => {
    const trackCandidate = carousel.querySelector("[data-carousel-track]");
    const dotsCandidate = carousel.querySelector("[data-carousel-dots]");

    if (!(trackCandidate instanceof HTMLElement) || !(dotsCandidate instanceof HTMLElement)) return;

    const track = trackCandidate;
    const dotsContainer = dotsCandidate;

    const slides = Array.from(track.children).filter(
      (child) => child instanceof HTMLElement,
    );

    if (slides.length <= 1) return;

    const interval = Number(carousel.getAttribute("data-interval")) || 6000;
    let currentIndex = 0;
    let timer: ReturnType<typeof setInterval> | null = null;

    const dots = slides.map((_, index) => {
      const dot = document.createElement("button");
      dot.type = "button";
      dot.className = "carousel__dot";
      dot.setAttribute("role", "tab");
      dot.setAttribute("aria-label", `Go to slide ${index + 1} of ${slides.length}`);
      dot.addEventListener("click", () => {
        goTo(index);
        restart();
      });
      dotsContainer.appendChild(dot);
      return dot;
    });

    function setTransform(index: number, gapPx: number, extraPx = 0) {
      track.style.transform = `translateX(calc(-${index * 100}% - ${index * gapPx}px + ${extraPx}px))`;
    }

    function goTo(index: number) {
      currentIndex = (index + slides.length) % slides.length;
      const gapPx = parseFloat(getComputedStyle(track).columnGap) || 0;
      setTransform(currentIndex, gapPx);

      slides.forEach((slide, i) => {
        slide.setAttribute("aria-hidden", String(i !== currentIndex));
      });

      dots.forEach((dot, i) => {
        const isActive = i === currentIndex;
        dot.setAttribute("aria-selected", String(isActive));
        dot.classList.toggle("carousel__dot--active", isActive);
      });
    }

    function start() {
      if (prefersReducedMotion || timer) return;
      timer = setInterval(() => goTo(currentIndex + 1), interval);
    }

    function stop() {
      if (timer) {
        clearInterval(timer);
        timer = null;
      }
    }

    function restart() {
      stop();
      start();
    }

    carousel.addEventListener("mouseenter", stop);
    carousel.addEventListener("mouseleave", start);
    carousel.addEventListener("focusin", stop);
    carousel.addEventListener("focusout", start);

    const DRAG_THRESHOLD_RATIO = 0.2;
    let pointerStartX = 0;
    let pointerStartY = 0;
    let dragDeltaX = 0;
    let dragGapPx = 0;
    let isDragging = false;
    let isDragGesture = false;

    function endDrag() {
      isDragging = false;
      track.style.transition = "";

      if (isDragGesture) {
        const threshold = track.offsetWidth * DRAG_THRESHOLD_RATIO;
        const next =
          Math.abs(dragDeltaX) > threshold
            ? currentIndex + (dragDeltaX < 0 ? 1 : -1)
            : currentIndex;
        goTo(next);
      }

      restart();
    }

    track.addEventListener("pointerdown", (event) => {
      isDragging = true;
      isDragGesture = false;
      dragDeltaX = 0;
      pointerStartX = event.clientX;
      pointerStartY = event.clientY;
      dragGapPx = parseFloat(getComputedStyle(track).columnGap) || 0;
      track.style.transition = "none";
      track.setPointerCapture(event.pointerId);
      stop();
    });

    track.addEventListener("pointermove", (event) => {
      if (!isDragging) return;

      dragDeltaX = event.clientX - pointerStartX;
      const dragDeltaY = event.clientY - pointerStartY;

      if (!isDragGesture) {
        if (Math.abs(dragDeltaX) < 4 && Math.abs(dragDeltaY) < 4) return;
        isDragGesture = Math.abs(dragDeltaX) > Math.abs(dragDeltaY);
        if (!isDragGesture) return;
      }

      event.preventDefault();
      setTransform(currentIndex, dragGapPx, dragDeltaX);
    });

    track.addEventListener("pointerup", () => {
      if (isDragging) endDrag();
    });

    track.addEventListener("pointercancel", () => {
      if (isDragging) endDrag();
    });

    goTo(0);
    start();
  });
</script>

<style>
  .carousel {
    display: grid;
    gap: 20px;
  }

  .carousel__viewport {
    overflow: hidden;
  }

  .carousel__track {
    display: flex;
    gap: 20px;
    touch-action: pan-y;
    cursor: grab;
    transition: transform 420ms ease;
    will-change: transform;
  }

  .carousel__track:active {
    cursor: grabbing;
  }

  .carousel__track > :global(*) {
    flex: 0 0 100%;
    min-width: 0;
  }

  .carousel__dots {
    display: flex;
    justify-content: center;
    gap: 10px;
  }

  .carousel__dots :global(.carousel__dot) {
    appearance: none;
    -webkit-appearance: none;
    display: block;
    width: 10px;
    height: 10px;
    border: none;
    border-radius: 999px;
    background: var(--color-line);
    padding: 0;
    cursor: pointer;
    transition:
      background-color 160ms ease,
      transform 160ms ease;
  }

  .carousel__dots :global(.carousel__dot:hover),
  .carousel__dots :global(.carousel__dot:focus-visible) {
    background: var(--color-grey-50);
  }

  .carousel__dots :global(.carousel__dot--active) {
    background: var(--color-grey-100);
    transform: scale(1.15);
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      transition: none;
    }
  }
</style>
