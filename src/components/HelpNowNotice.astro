---
// Where to get help in an emergency, as therapy isn't an emergency service.
import Eyebrow from "./Eyebrow.astro";
import Panel from "./Panel.astro";
---

<aside aria-labelledby="help-now-title">
  <Panel variant="amber">
    <div class="help-now">
      <p class="help-now__title" id="help-now-title">
        <Eyebrow>If you need help now</Eyebrow>
      </p>
      <p>
        Therapy is not an emergency service. If you need support today, contact
        your GP, call NHS 111, or call the Samaritans free on 116 123.
      </p>
    </div>
  </Panel>
</aside>

<style>
  .help-now {
    font-size: var(--text-small);
    line-height: 1.6;
  }

  p {
    margin: 0;
  }

  /* So the paragraph is only as tall as the eyebrow, not a line of body text. */
  .help-now__title {
    display: flex;
    margin-bottom: var(--space-2);
  }

  .help-now__title :global(.eyebrow) {
    color: inherit;
  }
</style>
