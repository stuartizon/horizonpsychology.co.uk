---
// A registration or accreditation logo, linking to the body that gives it in
// a new tab. The logo's alt text names the body in full, and screen readers
// are told the link opens a new tab.
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  href: string;
  src: ImageMetadata;
  name: string;
}

const { href, src, name } = Astro.props;
---

<a
  class="credential-logo"
  href={href}
  target="_blank"
  rel="noopener"
  title={name}
>
  <Image src={src} alt={name} height={88} densities={[1, 2]} />
  <span class="visually-hidden"> (opens in a new tab)</span>
</a>

<style>
  .credential-logo {
    display: block;
    transition: opacity var(--duration-base) var(--ease-calm);
  }

  .credential-logo:hover {
    opacity: 0.8;
  }

  /* The artwork's white background takes on the page's colour. */
  .credential-logo img {
    display: block;
    width: auto;
    height: 88px;
    mix-blend-mode: multiply;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
