---
import type { Service } from "@/data/services";

interface Props {
  service: Service;
}

const { service } = Astro.props;

const icons = import.meta.glob<string>("../icons/*.svg", {
  query: "?raw",
  import: "default",
  eager: true,
});
const icon = icons[`../icons/${service.id}.svg`];
---

<article class="service-card">
  <span class="service-card__icon" aria-hidden="true" set:html={icon} />
  <h3>{service.name}</h3>
  <p class="service-card__summary">{service.summary}</p>
  <p class="service-card__meta">{service.minutes} minutes</p>
  <a href={`/${service.id}/`}>
    Find out more
    <span class="service-card__arrow" aria-hidden="true">
      →
    </span>
  </a>
</article>

<style>
  .service-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-panel);
    padding: var(--space-6);
    box-shadow: var(--shadow-rest);
    transition:
      transform var(--duration-base) var(--ease-calm),
      box-shadow var(--duration-base) var(--ease-calm),
      border-color var(--duration-base) var(--ease-calm);
  }

  .service-card:hover,
  .service-card:focus-within {
    border-color: var(--color-sage-300);
    box-shadow: var(--shadow-raised);
    transform: translateY(-3px);
  }

  .service-card__icon {
    display: grid;
    width: 52px;
    height: 52px;
    place-items: center;
    border-radius: var(--radius-pill);
    background: var(--color-sage-50);
    color: var(--color-sage-600);
  }

  .service-card__icon :global(svg) {
    width: 26px;
    height: 26px;
  }

  h3,
  p {
    margin: 0;
  }

  .service-card__summary {
    flex: 1;
    color: var(--color-ink-soft);
    font-size: var(--text-small);
    line-height: 1.6;
  }

  .service-card__meta {
    color: var(--color-amber-800);
    font-size: var(--text-caption);
  }

  a {
    align-self: start;
    color: var(--color-sage-600);
    font-size: var(--text-small);
    font-weight: var(--weight-semibold);
    text-decoration: none;
  }

  /* The whole card is the link. */
  a::after {
    position: absolute;
    inset: 0;
    content: "";
  }

  .service-card__arrow {
    display: inline-block;
    margin-left: 6px;
    transition: transform var(--duration-base) var(--ease-calm);
  }

  .service-card:hover .service-card__arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card:hover,
    .service-card:focus-within,
    .service-card:hover .service-card__arrow {
      transform: none;
    }
  }
</style>
