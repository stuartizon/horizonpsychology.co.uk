---
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
} = Astro.props;

const pageTitle = title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navbar />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: light;
    --color-ink: #263331;
    --color-muted: #65716d;
    --color-line: #cfd9d4;
    --color-paper: #f7f8f4;
    --color-panel: #ffffff;
    --color-sage-50: #eef5f0;
    --color-sage-100: #dfeae4;
    --color-sage-300: #aac6b8;
    --color-sage-600: #58796b;
    --color-sage-800: #2f5147;
    --color-cream: #fbf7ef;
    --color-accent: var(--color-sage-600);
    --color-accent-strong: var(--color-sage-800);
    --color-warm: #9a7a55;
    --color-nav-surface: var(--color-sage-100);
    --color-nav-border: var(--color-sage-300);
    --color-nav-text: var(--color-ink);
    --color-nav-action: var(--color-sage-600);
    --color-nav-action-text: var(--color-panel);
    --color-nav-menu: var(--color-sage-800);
    --color-service-surface: var(--color-sage-50);
    --color-service-heading: var(--color-sage-800);
    --color-service-icon: var(--color-sage-600);
    --color-service-icon-mark: var(--color-panel);
    --font-sans:
      Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--color-paper);
    color: var(--color-ink);
    font-family: var(--font-sans);
  }

  body {
    min-height: 100vh;
    margin: 0;
    display: flex;
    flex-direction: column;
    line-height: 1.6;
  }

  body::before {
    position: fixed;
    inset: 0;
    z-index: -1;
    content: "";
    background:
      linear-gradient(120deg, rgb(88 121 107 / 0.1), transparent 36%),
      linear-gradient(300deg, rgb(170 198 184 / 0.12), transparent 32%);
  }

  a {
    color: inherit;
    text-decoration-color: var(--color-sage-300);
    text-underline-offset: 0.2em;
  }

  a:hover {
    color: var(--color-accent-strong);
  }

  main {
    flex: 1;
  }

  .page-section {
    width: min(100% - 32px, 1080px);
    margin-inline: auto;
  }

  h1,
  h2 {
    line-height: 1.08;
  }

  h1 {
    max-width: 12ch;
    margin: 0;
    font-size: clamp(3rem, 12vw, 7rem);
  }

  h2 {
    margin: 0 0 16px;
    font-size: clamp(2rem, 5vw, 3.6rem);
  }

  p {
    max-width: 68ch;
  }

  .lede {
    margin: 24px 0 0;
    color: var(--color-muted);
    font-size: clamp(1.12rem, 2.4vw, 1.45rem);
  }

  .page-section {
    padding-block: clamp(48px, 10vw, 96px);
  }

  .split {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(280px, 1fr);
    gap: clamp(28px, 6vw, 72px);
    align-items: start;
  }

  .section-label {
    margin: 0;
    color: var(--color-warm);
    font-size: 0.78rem;
    font-weight: 800;
    text-transform: uppercase;
  }

  .list {
    display: grid;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .list li {
    border-top: 1px solid var(--color-line);
    padding-top: 18px;
  }

  .list h2,
  .list h3 {
    margin: 0 0 6px;
    font-size: 1.2rem;
    line-height: 1.25;
  }

  .list p {
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 720px) {
    .split {
      grid-template-columns: 1fr;
    }
  }
</style>
