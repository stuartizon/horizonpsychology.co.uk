---
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/source-sans-3/wght-italic.css";
import "@fontsource/lora/400.css";
import "@fontsource/lora/400-italic.css";
// The Latin files of the two fonts most text uses, preloaded so they download
// alongside the stylesheet instead of after it, and text flashes less in a
// fallback font. The same files the stylesheet asks for.
import loraUrl from "@fontsource/lora/files/lora-latin-400-normal.woff2?url";
import sourceSansUrl from "@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Use the tall header that shrinks as you scroll (home page). */
  wideHeader?: boolean;
  /** Leave out the canonical URL, for the 404 page, which is shown at any missing path. */
  noCanonical?: boolean;
  /** Keep the page out of search results, for pages only reached by sending a form. */
  noindex?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  wideHeader = false,
  noCanonical = false,
  noindex = false,
} = Astro.props;

const pageTitle =
  title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const shareImage = new URL("/share.jpg", Astro.site);
const canonical = noCanonical
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    {[loraUrl, sourceSansUrl].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Horizon Psychology: therapy and supervision with Dr Emma Izon, Clinical Psychologist, online or face-to-face in Buckinghamshire"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <Navbar wide={wideHeader} />
    <main>
      <slot />
    </main>
    <Footer />
    <script>
      import { loadAnalytics, track } from "@/analytics";

      loadAnalytics();
      document.addEventListener("click", (event) => {
        if ((event.target as Element).closest?.('a[href^="mailto:"]'))
          track("Email link clicked");
      });
    </script>
  </body>
</html>
