---
import "@fontsource-variable/source-sans-3";
import "@fontsource-variable/source-sans-3/wght-italic.css";
import "@fontsource/lora/400.css";
import "@fontsource/lora/400-italic.css";
import Footer from "../components/Footer.astro";
import Navbar from "../components/Navbar.astro";
import { SITE_DESCRIPTION, SITE_TITLE } from "../consts";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  /** Use the tall header that shrinks as you scroll (home page). */
  wideHeader?: boolean;
  /** Leave out the canonical URL, for the 404 page, which is shown at any missing path. */
  noCanonical?: boolean;
}

const {
  title = SITE_TITLE,
  description = SITE_DESCRIPTION,
  wideHeader = false,
  noCanonical = false,
} = Astro.props;

const pageTitle =
  title === SITE_TITLE ? SITE_TITLE : `${title} | ${SITE_TITLE}`;
const shareImage = new URL("/share.jpg", Astro.site);
const canonical = noCanonical
  ? undefined
  : new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_TITLE} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="Horizon Psychology: therapy and supervision with Dr Emma Izon, Clinical Psychologist, online or face-to-face in Buckinghamshire"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <Navbar wide={wideHeader} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
