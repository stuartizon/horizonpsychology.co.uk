---
import "@fontsource/lora/400-italic.css";
import ServiceCard from "../components/ServiceCard.astro";
import Button from "../components/Button.astro";
import CredentialBadge from "../components/CredentialBadge.astro";
import Carousel from "../components/Carousel.astro";
import TestimonialCard from "../components/TestimonialCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import Container from "@/components/Container.astro";
import individualTherapyIcon from "../icons/individual-therapy.svg?raw";
import couplesTherapyIcon from "../icons/couples-therapy.svg?raw";
import clinicalSupervisionIcon from "../icons/clinical-supervision.svg?raw";
import researchSupervisionIcon from "../icons/research-supervision.svg?raw";

const services = [
  {
    title: "Individual Therapy",
    description:
      "We offer personalised therapy for adults and older adults, supporting difficulties including anxiety, trauma, depression, life changes, stress, and academic or sport-related performance pressures.",
    href: "/individual-therapy/",
    icon: individualTherapyIcon,
  },
  {
    title: "Couples Therapy",
    description:
      "We offer couples and partner psychotherapy for any two people wishing to work on a shared issue, supporting relationship difficulties, communication, and patterns of interaction using systemic and CBT-informed approaches in a safe, collaborative space.",
    href: "/couples-therapy/",
    icon: couplesTherapyIcon,
  },
  {
    title: "Clinical Supervision",
    description:
      "We offer individual and group supervision for psychologists, CBT therapists, and mental health professionals, alongside reflective practice, training, and consultation for organisations on mental health, neurodiversity, and wellbeing.",
    href: "/clinical-supervision/",
    icon: clinicalSupervisionIcon,
  },
  {
    title: "Research Supervision",
    description:
      "We offer research supervision for Master's and Doctoral students, providing structured, personalised support across every stage of the research process, from study design and ethics to data analysis, academic writing, and publication.",
    href: "/research-supervision/",
    icon: researchSupervisionIcon,
  },
];

const testimonials = [
  {
    quote:
      "I thoroughly enjoyed working with Emma and found her help invaluable. When I came to Emma, I was looking for someone with whom I could team up with on my journey of self understanding, who could provide suitable guidance along the way. Emma definitely provided what I was looking for. She was understanding, insightful and brought relevant, clinical knowledge based on what could be applied to me. She worked with me, at my pace, allowing me to evaluate and observe myself with her professional guidance along the way. She helped me to establish mechanisms and habits that can be used in future situations, as well as enlightening me of different psychological theories that have led to a deeper sense of self-understanding.",
    name: "James",
  },
  {
    quote:
      "I enjoyed having a space to express my feelings and thoughts that was warm and judgement free. I had been going through a period where I didn't always have that sort of space in my day to day interactions, so it was appreciated in my sessions with Emma. I also liked the professional and clinical knowledge that Emma brought and applied, within the sessions. I could really apply many of the methods and ideas she brought, to my daily interactions, and saw a positive impact.",
    name: "Sophie",
  },
  {
    quote:
      "I very much enjoyed working with Emma. I had a very positive experience and would turn to her again in future if I was seeking support through psychology.",
    name: "Daniel",
  },
  {
    quote:
      "I had a positive experience with Emma. I feel she understands my personal approach to psychology and our sessions, and I enjoyed working with her towards my goals.",
    name: "Priya",
  },
  {
    quote:
      "Thank you very much for all of the therapy sessions, I really appreciated them and feel I have learnt so much. You lent a non judgemental ear, and safe environment whereby I felt able to express myself and open up. The advice and strategies you gave me over the course of our sessions have proved invaluable, I have already implemented some and truly they are what kept me calm in some more stressful moments.",
    name: "Laura",
  },
  {
    quote:
      "Emma created a safe and reassuring environment for my son to talk, listen and ask questions. Her focus was clearly on my son rather than him feeling it was adults talking about him or over him. She made him feel safe to talk and share when normally he is reluctant. My son felt the sessions were fun, engaging and relevant.",
    name: "Rachel",
  },
  {
    quote: "All the sessions were helpful because they were done to fit me specifically.",
    name: "Tom",
  },
  {
    quote:
      "Emma is very nice and helpful. She is funny and makes things understandable and puts them into context.",
    name: "Grace",
  },
];
---

<BaseLayout>
  <Container>
    <section class="home-intro" aria-label="HorIZON Psychology">
      <img
        class="home-intro__logo"
        src="/images/logo.png"
        alt="HorIZON Psychology logo"
        width="681"
        height="374"
      />

      <p class="home-intro__tagline">
        Psychological Therapy <span aria-hidden="true">|</span> Research
        <span aria-hidden="true">|</span> Supervision
      </p>

      <blockquote>
        &ldquo;A space for support, understanding, and change. Helping you move
        through difficult times, one step at a time.&rdquo;
      </blockquote>

      <h2 class="home-intro__heading">What we offer</h2>

      <div class="home-intro__media-row">
        <div class="home-intro__image-wrap">
          <img
            src="/images/emma-portrait.png"
            alt="Dr Emma Izon"
            width="208"
            height="208"
          />
        </div>
        <div class="home-intro__copy">
          <p>
            HorIZON Psychology is led by Dr Emma Izon. She provides evidence-based
            psychological therapy tailored to each person's individual needs and
            goals. Drawing on approaches including cognitive behavioural therapy
            (CBT), acceptance and commitment therapy (ACT), compassion focused
            therapy (CFT), systemic approaches and narrative therapies. She works
            collaboratively and integratively to offer thoughtful, flexible, and
            meaningful support. Her practice is compassionate,
            neurodiversity-affirming, and grounded in creating a safe,
            non-judgemental space for lasting understanding, resilience, and change.
          </p>
          <div class="home-intro__badges">
            <CredentialBadge
              label="HCPC registered"
              tooltip="Health Care Professions Council (HCPC) registered"
            />
            <CredentialBadge
              label="BABCP accredited"
              tooltip="British Association of Behavioural and Cognitive Psychotherapies (BABCP) accredited"
            />
            <CredentialBadge
              label="NICE evidence based practice"
              tooltip="Evidence based practice following the National Institute of Health and Care Excellence (NICE) guidelines for diagnostic assessments and therapy."
            />
          </div>
          <div class="home-intro__action">
            <Button href="/about/" label="More about me" type="primary" />
          </div>
        </div>
      </div>
    </section>

    <section class="services-section" aria-labelledby="services-heading">
      <h2 id="services-heading">Services</h2>
      <div class="services-section__grid">
        {
          services.map((service) => (
            <ServiceCard
              title={service.title}
              description={service.description}
              href={service.href}
              icon={service.icon}
            />
          ))
        }
      </div>
    </section>

    <section class="testimonials-section" aria-labelledby="testimonials-heading">
      <h2 id="testimonials-heading">Testimonials</h2>
      <Carousel label="Client testimonials">
        {
          testimonials.map((testimonial) => (
            <TestimonialCard quote={testimonial.quote} name={testimonial.name} />
          ))
        }
      </Carousel>
    </section>
  </Container>
</BaseLayout>

<style>
  .home-intro {
    padding-block: 18px 26px;
  }

  .home-intro__logo {
    display: block;
    width: 100%;
    max-width: 480px;
    height: auto;
    margin: 0 auto;
  }

  .home-intro__tagline {
    margin: 12px 0 0;
    color: var(--color-grey-100);
    font-size: 0.68rem;
    font-weight: 500;
    font-style: italic;
    text-align: center;
  }

  .home-intro__tagline span {
    color: var(--color-grey-50);
  }

  .home-intro__media-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
  }

  .home-intro__image-wrap {
    display: grid;
    width: 208px;
    aspect-ratio: 1;
    flex-shrink: 0;
    place-items: center;
    overflow: hidden;
    border-radius: 14px;
    background:
      linear-gradient(var(--color-line), var(--color-line)),
      var(--color-sage-100);
  }

  .home-intro__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-intro__heading {
    margin: 0 0 18px;
    text-transform: uppercase;
  }

  .home-intro__copy p {
    margin: 0;
    line-height: 1.5;
  }

  .home-intro__badges {
    display: flex;
    flex-wrap: wrap;
    row-gap: 14px;
    column-gap: 8px;
    margin: 14px 0 0;
  }

  .home-intro__action {
    display: table;
    margin: 32px auto 0;
  }

  @media (min-width: 761px) {
    .home-intro {
      display: grid;
      grid-template-columns: 280px minmax(280px, 1fr);
      column-gap: clamp(28px, 4vw, 48px);
      padding-block: 56px 18px;
    }

    .home-intro__logo {
      grid-column: 1 / -1;
      width: 480px;
      margin-bottom: 0;
    }

    .home-intro__tagline {
      grid-column: 1 / -1;
      margin: 16px 0 0;
      font-size: 0.95rem;
    }

    .home-intro__heading {
      grid-column: 1 / -1;
    }

    .home-intro__media-row {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      align-items: start;
      gap: 0;
    }

    .home-intro__image-wrap {
      width: min(100%, 280px);
    }

    .home-intro blockquote {
      grid-column: 1 / -1;
      max-width: none;
    }

    .home-intro__copy {
      max-width: none;
    }

    .home-intro__copy p {
      max-width: none;
    }
  }

  .services-section {
    padding-block: 42px clamp(56px, 8vw, 96px);
  }

  .services-section h2 {
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .services-section__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  @media (max-width: 960px) {
    .services-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .services-section {
      padding-block: 28px 64px;
    }

    .services-section h2 {
      margin-bottom: 18px;
    }

    .services-section__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }

  .testimonials-section {
    padding-block: 0 clamp(56px, 8vw, 96px);
  }

  .testimonials-section h2 {
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .testimonials-section {
      padding-block: 0 64px;
    }

    .testimonials-section h2 {
      margin-bottom: 18px;
    }
  }
</style>
