---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import IntroCallPanel from "@/components/IntroCallPanel.astro";
import QuoteBand from "@/components/QuoteBand.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import ServiceCard from "@/components/ServiceCard.astro";
import { services } from "@/data/services";
import BaseLayout from "@/layouts/BaseLayout.astro";
import portrait from "@/photos/home.jpg";
---

<BaseLayout wideHeader>
  <Container>
    <div class="hero">
      <div class="hero__text">
        <SectionHeading
          eyebrow="Dr Emma Izon · Clinical Psychologist"
          title="A space for support, understanding, and change"
          level="h1"
          subtitle="Psychological therapy, clinical and research supervision for adults. Online, or face-to-face in Buckinghamshire. Helping you move through difficult times, one step at a time."
        />
        <div class="action">
          <Button href="/contact/" label="Get in touch" />
        </div>
      </div>
      <Image
        class="hero__portrait"
        src={portrait}
        alt="Dr Emma Izon"
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 512px, (min-width: 48rem) 50vw, 100vw"
        loading="eager"
      />
    </div>
  </Container>

  <section class="offer" aria-labelledby="offer-heading">
    <Container>
      <div class="offer__columns">
        <SectionHeading
          eyebrow="What we offer"
          title="Evidence-based therapy, delivered with warmth"
          id="offer-heading"
        />
        <div class="offer__body">
          <p>
            Horizon Psychology is led by Dr Emma Izon. She provides
            evidence-based psychological therapy tailored to each person's
            individual needs and goals, drawing on cognitive behavioural therapy
            (CBT), acceptance and commitment therapy (ACT), compassion-focused
            therapy (CFT), systemic approaches and narrative therapies. Her
            practice is compassionate, neurodiversity-affirming, and grounded in
            creating a safe, non-judgemental space for lasting understanding,
            resilience, and change.
          </p>
          <p class="offer__note">
            Diagnostic assessment and therapy follow National Institute for
            Health and Care Excellence (NICE) guidelines.
          </p>
          <div class="action">
            <Button href="/about/" label="More about Emma" type="link" />
          </div>
        </div>
      </div>
    </Container>
  </section>

  <section class="services" aria-labelledby="services-heading">
    <Container>
      <SectionHeading
        eyebrow="Services"
        title="Four ways of working together"
        id="services-heading"
      />
      <p class="services__lead">
        Every service begins with a free 15-minute call, so you can ask
        questions and decide whether it feels right.
      </p>
      <div class="services__grid">
        {services.map((service) => (
          <ServiceCard service={service} />
        ))}
      </div>
    </Container>
  </section>

  <QuoteBand quote="A space for support, understanding, and change. Helping you move through difficult times, one step at a time." />

  <div class="intro-call">
    <Container>
      <IntroCallPanel />
    </Container>
  </div>
</BaseLayout>

<style>
  p {
    margin: 0;
  }

  /* From a tablet up, the text sits beside the portrait. */
  .hero {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    align-items: start;
    padding-block: var(--section-y-tight) var(--section-y);
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    gap: 26px;
  }

  .hero__text :global(h1) {
    font-size: var(--text-hero);
  }

  .hero__portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-image);
    object-fit: cover;
    box-shadow: var(--shadow-rest);
  }

  /* Centred under full-width text on a phone. */
  .action {
    display: flex;
    justify-content: center;
  }

  .offer,
  .services {
    padding-bottom: var(--section-y);
  }

  .offer__columns {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
  }

  .offer__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .offer__note {
    color: var(--color-ink-soft);
    font-size: var(--text-small);
  }

  .services__lead {
    margin-top: var(--space-3);
    color: var(--color-ink-soft);
  }

  .services__grid {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-10);
  }

  .intro-call {
    padding-block: var(--section-y);
  }

  @media (min-width: 48rem) {
    /* The home header is taller than the others, with its links lower by half
       of its --shrink, so this takes that off the space above the hero. The
       portrait then starts as far below the links as the About page's. */
    .hero {
      grid-template-columns: 1fr 1fr;
      padding-top: calc(var(--section-y-tight) - var(--shrink, 0px) / 2);
    }

    .hero__text {
      max-width: 46ch;
    }

    /* Level with the top of the eyebrow's capitals, as on the About page. */
    .hero__portrait {
      margin-top: calc(0.78rem * 0.385);
    }

    .action {
      justify-content: flex-start;
    }

    /* The text takes up to its measure and the heading takes the rest, as on
       the About page. */
    .offer__columns {
      grid-template-columns: minmax(14rem, 1fr) minmax(0, var(--measure-prose));
      align-items: start;
    }

    .services__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* All four services in a row on a desktop. #77 settles the grid. */
  @media (min-width: 64rem) {
    .services__grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
