---
import Container from "@/components/Container.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Faqs from "@/components/Faqs.astro";
import FeesPanel from "@/components/FeesPanel.astro";
import { faqs } from "@/data/faqs";
import { services, type Service } from "@/data/services";

export function getStaticPaths() {
    return services.map((service) => ({
        params: { therapyId: service.id },
        props: { service },
    }));
}

interface Props {
    service: Service;
}

const { service } = Astro.props;
---

<BaseLayout title={service.name} description={service.summary}>
    <Container>
        <section aria-labelledby="therapy-heading">
            <h2 id="therapy-heading" class="therapy__heading">
                {service.name}
            </h2>
            <div class="therapy__section">
                <div class="therapy__description">
                    {service.description.map((paragraph) => <p>{paragraph}</p>)}
                </div>
                <div class="therapy__fees">
                    <FeesPanel service={service} />
                </div>
            </div>
        </section>
        <section aria-labelledby="questions-heading">
            <h3 id="questions-heading" class="questions__heading">
                Got questions?
            </h3>
            <Faqs faqs={service.faqs.map((id) => faqs[id])} />
        </section>
    </Container>

    <style>
        .therapy__heading {
            text-transform: uppercase;
            margin-bottom: 20px;
        }
        .therapy__section {
            display: flex;
            gap: 24px;
        }

        .therapy__description {
            flex: 1 1 auto;
            background-color: var(--color-sage-100);
            border-radius: 8px;
            padding: 24px;
        }
        .therapy__fees {
            flex: 0 0 300px;
        }
        .therapy__description p + p {
            margin-top: 12px;
        }
        .questions__heading {
            margin-top: 20px;
            margin-bottom: 20px;
        }

        @media (max-width: 640px) {
            .therapy__section {
                flex-direction: column;
            }
            .therapy__fees {
                flex: 1 1 auto;
            }
        }
    </style>
</BaseLayout>
