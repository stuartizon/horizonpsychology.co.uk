---
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import Faqs from "@/components/Faqs.astro";
import { services, type Service } from "@/data/services";

export function getStaticPaths() {
    return services.map((service) => ({
        params: { therapyId: service.id },
        props: { service },
    }));
}

interface Props {
    service: Service;
}

const { service } = Astro.props;
---

<BaseLayout title={service.name} description={service.summary}>
    <Container>
        <section aria-labelledby="therapy-heading">
            <h2 id="therapy-heading" class="therapy__heading">
                {service.name}
            </h2>
            <div class="therapy__section">
                <div class="therapy__description">
                    {service.description.map((paragraph) => <p>{paragraph}</p>)}
                </div>
                <div class="therapy__details">
                    <p>£{service.price} for a {service.minutes}-minute session</p>
                    {service.practical.map((item) => <p>{item}</p>)}
                </div>
            </div>
            <div class="therapy__action">
                <Button href="/schedule/" type="primary" label="Schedule" />
            </div>
        </section>
        <section aria-labelledby="questions-heading">
            <h3 id="questions-heading" class="questions__heading">
                Got questions?
            </h3>
            <Faqs />
        </section>
    </Container>

    <style>
        .therapy__heading {
            text-transform: uppercase;
            margin-bottom: 20px;
        }
        .therapy__section {
            display: flex;
            gap: 24px;
        }

        .therapy__description {
            flex: 1 1 auto;
            background-color: var(--color-sage-100);
            border-radius: 8px;
            padding: 24px;
        }
        .therapy__details {
            flex: 0 0 280px;
            width: 280px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            background-color: var(--color-sage-100);
            border-radius: 8px;
            padding: 24px;
        }
        .therapy__description p + p {
            margin-top: 12px;
        }
        .therapy__details p {
            margin: 0;
        }
        .therapy__action {
            margin-top: 24px;
            text-align: center;
        }
        .questions__heading {
            margin-top: 20px;
            margin-bottom: 20px;
        }

        @media (max-width: 640px) {
            .therapy__section {
                flex-direction: column;
            }
            .therapy__details {
                flex: 1 1 auto;
                width: auto;
            }
        }
    </style>
</BaseLayout>
