---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import hourglass from "@/photos/404.jpg";
---

<BaseLayout
  title="Page not found"
  description="The page you were looking for isn't on the Horizon Psychology website."
>
  <Container>
    <div class="not-found">
      <SectionHeading
        eyebrow="Page not found"
        title="This page isn't here"
        level="h1"
        subtitle="But support, clarity and conversation still are."
      />
      <Image
        class="not-found__photo"
        src={hourglass}
        alt="An hourglass on a table"
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 512px, (min-width: 48rem) 50vw, 100vw"
        loading="eager"
      />
      <div class="not-found__action">
        <Button href="/" label="Return home" />
      </div>
    </div>
  </Container>
</BaseLayout>

<style>
  /* The heading, photo and button stack on a phone, with the button last. */
  .not-found {
    display: grid;
    gap: clamp(32px, 5vw, 72px);
    padding-block: var(--section-y-tight) var(--section-y);
  }

  .not-found__action {
    display: flex;
    justify-content: center;
  }

  .not-found__photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
    box-shadow: var(--shadow-rest);
  }

  /* From tablet width, the photo takes the right column, with the heading and
     button together, centred down its left. */
  @media (min-width: 48rem) {
    .not-found {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: 1fr auto auto 1fr;
      grid-template-areas:
        ". photo"
        "heading photo"
        "action photo"
        ". photo";
      row-gap: 0;
    }

    .not-found > :global(.section-heading) {
      grid-area: heading;
    }

    .not-found__photo {
      grid-area: photo;
      align-self: center;
    }

    .not-found__action {
      grid-area: action;
      justify-content: flex-start;
      margin-top: 26px;
    }
  }
</style>
