---
import ServiceCard from "./ServiceCard.astro";

const services = [
  {
    title: "Individual Therapy",
    description:
      "We offer personalised therapy for adults and older adults, supporting difficulties including anxiety, trauma, depression, life changes, stress, and academic or sport-related performance pressures.",
    href: "/individual-therapy/",
  },
  {
    title: "Couples Therapy",
    description:
      "We offer couples and partner psychotherapy for any two people wishing to work on a shared issue, supporting relationship difficulties, communication, and patterns of interaction using systemic and CBT-informed approaches in a safe, collaborative space.",
    href: "/couples-therapy/",
  },
  {
    title: "Clinical Supervision",
    description:
      "We offer individual and group supervision for psychologists, CBT therapists, and mental health professionals, alongside reflective practice, training, and consultation for organisations on mental health, neurodiversity, and wellbeing.",
    href: "/clinical-supervision/",
  },
  {
    title: "Research Supervision",
    description:
      "We offer research supervision for Master's and Doctoral students, providing structured, personalised support across every stage of the research process, from study design and ethics to data analysis, academic writing, and publication.",
    href: "/research-supervision/",
  },
];
---

<section class="services-section" aria-labelledby="services-heading">
  <h2 id="services-heading">Services</h2>
  <div class="services-section__grid">
    {
      services.map((service) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          href={service.href}
        />
      ))
    }
  </div>
</section>

<style>
  .services-section {
    padding-block: 42px clamp(56px, 8vw, 96px);
  }

  .services-section h2 {
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .services-section__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  @media (max-width: 960px) {
    .services-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .services-section {
      padding-block: 28px 64px;
    }

    .services-section h2 {
      margin-bottom: 18px;
    }

    .services-section__grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
  }
</style>
