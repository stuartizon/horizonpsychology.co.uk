---
import ServiceCard from "./ServiceCard.astro";

const services = [
  {
    title: "Psychological Therapy",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam nec sapien nec est tincidunt blandit.",
    href: "/psychological-therapy/",
  },
  {
    title: "Couples Psychotherapy",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam nec sapien nec est tincidunt blandit.",
    href: "/couples-psychotherapy/",
  },
  {
    title: "Clinical Supervision",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam nec sapien nec est tincidunt blandit.",
    href: "/clinical-supervision/",
  },
  {
    title: "Research Supervision",
    description:
      "Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam nec sapien nec est tincidunt blandit.",
    href: "/research-supervision/",
  },
];
---

<section class="services-section" aria-labelledby="services-heading">
  <h2 id="services-heading">Services</h2>
  <div class="services-section__grid">
    {
      services.map((service) => (
        <ServiceCard
          title={service.title}
          description={service.description}
          href={service.href}
        />
      ))
    }
  </div>
</section>

<style>
  .services-section {
    padding-block: 42px clamp(56px, 8vw, 96px);
  }

  .services-section h2 {
    margin: 0 0 16px;
    text-transform: uppercase;
  }

  .services-section__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 28px;
  }

  @media (max-width: 960px) {
    .services-section__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .services-section {
      padding-block: 28px 64px;
    }

    .services-section h2 {
      margin-bottom: 18px;
    }

    .services-section__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
