---
import Button from "../../../components/Button.astro";
---

<section class="home-intro" aria-labelledby="home-intro-heading">
  <h1 id="home-intro-heading">
    Hor<span class="home-intro__italic">izon</span> Psychology
  </h1>

  <div class="home-intro__media-row">
    <div class="home-intro__image-wrap">
      <img
        src="/images/emma-portrait.png"
        alt="Dr Emma Izon"
        width="208"
        height="208"
      />
    </div>
    <div class="home-intro__copy">
      <h2>What we offer</h2>
      <p>
        Horizon Psychology is led by Dr Emma Izon. She provides evidence-based
        psychological therapy tailored to each person's individual needs and
        goals. Drawing on approaches including cognitive behavioural therapy
        (CBT), acceptance and commitment therapy (ACT), compassion focused therapy
        (CFT), systemic approaches and narrative therapies. She works
        collaboratively and integratively to offer thoughtful, flexible, and
        meaningful support. Her practice is compassionate,
        neurodiversity-affirming, and grounded in creating a safe, non-
        judgemental space for lasting understanding, resilience, and change.
      </p>
      <div class="home-intro__action">
        <Button href="/about/" label="More about me" />
      </div>
    </div>
  </div>

  <blockquote>
    <p>
      “A space for support, understanding, and change. Helping you move
      through difficult times, one step at a time.”
    </p>
  </blockquote>
</section>

<style>
  .home-intro {
    width: min(100% - 40px, 520px);
    margin-inline: auto;
    padding-block: 18px 26px;
  }

  .home-intro__italic {
    font-style: italic;
  }

  .home-intro h1 {
    max-width: none;
    margin: 0 0 18px;
    color: var(--color-grey-600);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
  }

  .home-intro__media-row {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 18px;
    margin-bottom: 22px;
  }

  .home-intro__image-wrap {
    display: grid;
    width: 208px;
    aspect-ratio: 1;
    flex-shrink: 0;
    place-items: center;
    overflow: hidden;
    border-radius: 14px;
    background:
      linear-gradient(var(--color-line), var(--color-line)),
      var(--color-sage-100);
  }

  .home-intro__image-wrap img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .home-intro blockquote {
    margin: 0;
    color: var(--color-grey-600);
    font-style: italic;
    line-height: 1.22;
    text-align: center;
  }

  .home-intro blockquote p {
    font-size: 1.5rem;
    margin: 0;
  }

  .home-intro__copy h2 {
    margin: 0 0 10px;
    color: var(--color-grey-600);
    font-size: 1.1rem;
    font-weight: 800;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .home-intro__copy p {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.16;
  }

  .home-intro__action {
    display: table;
    margin: 20px auto 0;
  }

  @media (min-width: 761px) {
    .home-intro {
      width: min(100% - 160px, 900px);
      display: grid;
      grid-template-columns: 280px minmax(280px, 1fr);
      column-gap: clamp(28px, 4vw, 48px);
      padding-block: 56px 18px;
    }

    .home-intro h1 {
      grid-column: 1 / -1;
      margin-bottom: 28px;
      font-size: clamp(1.8rem, 3vw, 2.8rem);
    }

    .home-intro__media-row {
      grid-column: 1 / -1;
      display: grid;
      grid-template-columns: subgrid;
      align-items: start;
      gap: 0;
      margin-bottom: 36px;
    }

    .home-intro__image-wrap {
      width: min(100%, 280px);
    }

    .home-intro blockquote {
      grid-column: 1 / -1;
      max-width: none;
      font-size: clamp(1.5rem, 3vw, 2.5rem);
    }

    .home-intro__copy {
      max-width: none;
    }

    .home-intro__copy p {
      max-width: none;
    }
  }
</style>
