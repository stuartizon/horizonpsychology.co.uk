---
import Container from "@/components/Container.astro";
import Button from "../components/Button.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="About" description="About Emma">
  <Container>
    <section class="about" aria-labelledby="about-heading">
      <h2 id="about-heading">ABOUT ME</h2>
      <img
        class="about__image"
        src="/images/emma-about-me.png"
        alt="Dr Emma Izon"
      />
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Aliquam nec
        sapien nec est tincidunt blandit. Orci varius natoque penatibus et
        magnis dis parturient montes, nascetur ridiculus mus. Nam augue lectus,
        volutpat vitae turpis a, fringilla tincidunt metus. Donec egestas
        laoreet massa nec pharetra.
      </p>
      <div class="about__action">
        <Button href="/schedule/" type="primary" label="Schedule" />
      </div>
    </section>
    <blockquote>
      "Lorem ipsum dolor sit amet consectetur adipiscing elit"
    </blockquote>
  </Container>
</BaseLayout>

<style>
  .about {
    display: inline-block;
  }

  .about__image {
    width: 320px;
    height: 320px;
    object-fit: cover;
    border-radius: 18px;
    float: right;
    margin: 1em 0 0.5em 1em;
  }

  @media (max-width: 640px) {
    .about__image {
      width: 150px;
      height: 150px;
    }
  }

  .about__action {
    text-align: center;
  }
</style>
