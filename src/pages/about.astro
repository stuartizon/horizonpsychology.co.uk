---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import CredentialLogo from "@/components/CredentialLogo.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import { testimonials } from "@/data/testimonials";
import BaseLayout from "@/layouts/BaseLayout.astro";
import babcpAccredited from "@/logos/babcp-accredited.png";
import hcpcRegistered from "@/logos/hcpc-registered.webp";
import portrait from "@/photos/about.jpg";
import bookshelf from "@/photos/about-approach.jpg";
---

<BaseLayout
  title="About Emma"
  description="Dr Emma Izon is a Clinical Psychologist offering therapy and supervision, online or face-to-face in Buckinghamshire."
>
  <Container>
    <div class="about">
      <div class="about__intro">
        <Image
          class="about__portrait"
          src={portrait}
          alt="Dr Emma Izon"
          widths={[480, 800, 1200]}
          sizes="(min-width: 48rem) 50vw, 100vw"
        />
        <SectionHeading
          eyebrow="About Emma"
          title="Dr Emma Izon"
          level="h1"
          subtitle="Clinical Psychologist · DClinPsych, PhD, MSc, BSc (International)"
        />
        <p>
          Dr Emma Izon is a Clinical Psychologist who trained at the University
          of Oxford and holds a PhD in Clinical Psychology from the University
          of Manchester. She has extensive experience delivering psychological
          assessment and therapy across national specialist and local NHS
          services, as well as private healthcare.
        </p>
        <p>
          Emma has particular expertise in working with psychosis, paranoia and
          complex psychological presentations, alongside experience supporting
          people experiencing anxiety, depression, stress and difficulties
          associated with life transitions. Her approach is trauma-informed and
          neurodiversity-affirming, with a focus on helping individuals
          understand their experiences, develop new perspectives and work
          towards meaningful change.
        </p>
        <p>
          Emma has undertaken additional training in enhanced Cognitive
          Behavioural Therapy (CBT) for psychosis and bipolar disorder. Her
          research interests include the at-risk mental state for psychosis and
          the experiences, needs and wellbeing of family members and loved ones.
          She values a systemic perspective, recognising the importance of
          relationships, family support and the wider circumstances that shape
          our mental health and wellbeing.
        </p>
        <p>
          Emma also has a particular interest in sport and psychological
          wellbeing. As a competitive netball player and high-level netball
          umpire, she brings personal insight into the demands of competitive
          sport and the psychological challenges athletes can face. She has
          undertaken additional learning in sport and mental health, including
          performance anxiety, the psychological impact of injury, athlete
          wellbeing and the challenges associated with transitioning out of a
          sporting career. She is interested in supporting athletes to navigate
          these challenges, manage the pressures of performance and maintain
          their psychological wellbeing both within and beyond sport.
        </p>
        <p>
          Emma offers a compassionate, collaborative approach, creating a safe
          and supportive space in which individuals can explore their
          experiences, make sense of emotional difficulties and develop
          strategies to support lasting change. Alongside her clinical work, she
          provides clinical and research supervision, drawing on her experience
          across clinical practice and research.
        </p>
        <div class="about__credentials">
          <CredentialLogo
            href="https://www.hcpc-uk.org/check-the-register/professional-registration-detail/?query=PYL043541&profession=PYL"
            src={hcpcRegistered}
            name="Health and Care Professions Council (HCPC) registered"
          />
          <CredentialLogo
            href="https://portal.babcp.com/therapist/register"
            src={babcpAccredited}
            name="British Association for Behavioural and Cognitive Psychotherapies (BABCP) accredited"
          />
        </div>
      </div>
    </div>
  </Container>

  <section class="testimonials" aria-labelledby="testimonials-heading">
    <Container>
      <SectionHeading
        eyebrow="Testimonials"
        title="What people have said"
        id="testimonials-heading"
      />
      <div class="testimonials__carousel">
        <TestimonialCarousel testimonials={testimonials} />
      </div>
    </Container>
  </section>

  <section class="approach" aria-labelledby="approach-heading">
    <Container>
      <div class="approach__columns">
        <Image
          class="approach__photo"
          src={bookshelf}
          alt="Psychology books, a trailing plant and succulents on a wooden shelf"
          widths={[480, 800, 1200]}
          sizes="(min-width: 48rem) 45vw, 100vw"
        />
        <SectionHeading
          eyebrow="Therapeutic approach"
          title="How Emma works"
          id="approach-heading"
        />
        <p>
          Emma believes that therapy is most effective when built on a safe,
          trusting and collaborative relationship. She offers a calm,
          confidential and non-judgemental space where clients can explore their
          experiences at a pace that feels right for them, without pressure or
          fear of judgement. Whether navigating stress, anxiety, low mood, the
          impact of trauma, relationship difficulties or significant life
          transitions, Emma works alongside clients to make sense of their
          experiences and find a way forward that feels meaningful to them.
        </p>
        <p>
          Her approach is compassionate, integrative and grounded in
          evidence-based psychological practice. Working primarily within a
          Cognitive Behavioural Therapy (CBT) framework, Emma draws on a range
          of approaches, including Mindfulness-Based CBT, Compassion-Focused
          Therapy (CFT), Acceptance and Commitment Therapy (ACT), systemic
          practices and narrative therapies. This flexible approach allows
          therapy to be tailored to each individual’s needs, strengths and
          goals. Committed to trauma-informed, neurodiversity-affirming and
          culturally sensitive practice, Emma combines warmth and compassionate
          honesty with evidence-based care to support greater
          self-understanding, resilience and meaningful, lasting change.
        </p>
      </div>
      <div class="approach__actions">
        <Button href="/contact/" label="Get in touch" />
        <Button
          href="/research/"
          label="See publications"
          variant="secondary"
        />
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  p {
    margin: 0;
  }

  .about {
    padding-block: var(--section-y-tight) var(--section-y);
  }

  /* Each photo comes first, so it can float beside the text that follows.
     On a phone it moves down to break up the text: the portrait after the
     second paragraph, and the bookshelf after the first. */
  .about__intro {
    --gap: clamp(32px, 5vw, 64px);
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about__portrait {
    order: 1;
  }

  .about__intro > p:nth-of-type(2) ~ * {
    order: 2;
  }

  .about__credentials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-6);
  }

  .about__portrait,
  .approach__photo {
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
    box-shadow: var(--shadow-rest);
  }

  .testimonials {
    background: var(--color-sage-50);
    padding-block: var(--section-y);
  }

  .testimonials__carousel {
    max-width: var(--measure-feature);
    margin: 36px auto 0;
  }

  .approach {
    padding-block: var(--section-y);
  }

  .approach__columns {
    --gap: clamp(28px, 5vw, 72px);
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .approach__photo {
    order: 1;
  }

  .approach__columns > p + p {
    order: 2;
  }

  .approach__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  /* From a tablet up, the text wraps around each photo: the portrait on the
     right and the bookshelf on the left. Each photo's top is level with the
     top of its eyebrow's capitals, not its line: they start 0.385em down its
     0.78rem text, below the space the font leaves above them. */
  @media (min-width: 48rem) {
    .about__intro,
    .approach__columns {
      display: flow-root;
    }

    .about__portrait {
      float: right;
      width: calc(50% - var(--gap) / 2);
      margin: calc(0.78rem * 0.385) 0 var(--space-6) var(--gap);
    }

    .about__intro > p,
    .about__credentials {
      margin-top: var(--space-6);
    }

    .approach__photo {
      float: left;
      width: 45%;
      margin: calc(0.78rem * 0.385) var(--gap) var(--space-5) 0;
    }

    .approach__columns > p {
      margin-top: var(--space-5);
    }
  }

  /* On a desktop the text keeps to its own column beside each photo, at most
     a readable measure wide, and the approach's ends in line with the
     portrait. */
  @media (min-width: 64rem) {
    .about__intro > :global(:not(.about__portrait)) {
      max-width: min(var(--measure-prose), calc(50% - var(--gap) / 2));
    }

    .approach__columns {
      display: grid;
      grid-template-columns: minmax(14rem, 1fr) minmax(0, var(--measure-prose));
      grid-template-rows: auto auto 1fr;
      gap: var(--space-5) var(--gap);
      align-items: start;
    }

    .approach__columns > :global(*) {
      grid-column: 2;
    }

    .approach__columns > p {
      margin-top: 0;
    }

    .approach__photo {
      grid-column: 1;
      grid-row: 1 / span 3;
      width: 100%;
      margin: calc(0.78rem * 0.385) 0 0;
    }
  }
</style>
