---
import { Image } from "astro:assets";
import Button from "@/components/Button.astro";
import Container from "@/components/Container.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import TestimonialCarousel from "@/components/TestimonialCarousel.astro";
import { testimonials } from "@/data/testimonials";
import BaseLayout from "@/layouts/BaseLayout.astro";
import portrait from "@/photos/about.jpg";
---

<BaseLayout
  title="About Emma"
  description="Dr Emma Izon is a Clinical Psychologist offering therapy and supervision, online or face-to-face in Buckinghamshire."
>
  <Container>
    <div class="about">
      <div class="about__intro">
        <SectionHeading
          eyebrow="About Emma"
          title="Dr Emma Izon"
          level="h1"
          subtitle="Clinical Psychologist · PhD, DClinPsych, MSc, BSc (International)"
        />
        <p>
          Dr Emma Izon is a Clinical Psychologist, Cognitive Behavioural
          Psychotherapist, and researcher who offers psychological therapy, as
          well as clinical and research supervision. Trained at the University
          of Oxford, she specialises in evidence-based, compassionate care, with
          particular expertise in psychosis, bipolar disorder, trauma-informed
          practice, and neurodiversity-affirming therapy.
        </p>
        <p>
          She works collaboratively with people from all walks of life, helping
          them understand their experiences, make sense of difficult emotions,
          and develop meaningful, lasting change.
        </p>
      </div>
      <Image
        class="about__portrait"
        src={portrait}
        alt="Dr Emma Izon"
        widths={[480, 800, 1200]}
        sizes="(min-width: 64rem) 512px, (min-width: 48rem) 50vw, 100vw"
      />
    </div>
  </Container>

  <section class="testimonials" aria-labelledby="testimonials-heading">
    <Container>
      <SectionHeading
        eyebrow="Client experience"
        title="What people have said"
        id="testimonials-heading"
      />
      <div class="testimonials__carousel">
        <TestimonialCarousel testimonials={testimonials} />
      </div>
    </Container>
  </section>

  <section class="approach" aria-labelledby="approach-heading">
    <Container>
      <div class="approach__columns">
        <SectionHeading
          eyebrow="Therapeutic approach"
          title="How Emma works"
          id="approach-heading"
        />
        <div class="approach__body">
          <p>
            Emma believes that therapy is most effective when it is built on a
            safe, trusting, and collaborative relationship. She offers a calm,
            confidential space where clients can explore their experiences at a
            pace that feels right for them, without judgement or pressure.
            Whether someone is experiencing stress, anxiety, low mood, the
            impact of trauma, relationship difficulties, or navigating
            significant life transitions, she works with them to make sense of
            their experiences and develop practical tools for lasting wellbeing.
          </p>
          <p>
            Her work is grounded in evidence-based psychological practice and
            integrates Cognitive Behavioural Therapy (CBT), Acceptance and
            Commitment Therapy (ACT), and Compassion-Focused Therapy (CFT),
            tailoring therapy to each individual's needs, strengths, and goals.
            Committed to trauma-informed, neurodiversity-affirming, and
            culturally sensitive practice, she combines compassionate honesty
            with evidence-based care to help clients build resilience, deepen
            self-understanding, and create meaningful, sustainable change.
          </p>
        </div>
      </div>
      <div class="approach__actions">
        <Button href="/contact/" label="Get in touch" />
        <Button href="/research/" label="See publications" type="secondary" />
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  p {
    margin: 0;
  }

  .about {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: start;
    padding-block: var(--section-y-tight) var(--section-y);
  }

  .about__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }

  .about__portrait {
    width: 100%;
    height: auto;
    border-radius: var(--radius-image);
    box-shadow: var(--shadow-rest);
  }

  .testimonials {
    background: var(--color-sage-50);
    padding-block: var(--section-y);
  }

  .testimonials__carousel {
    max-width: var(--measure-feature);
    margin: 36px auto 0;
  }

  .approach {
    padding-block: var(--section-y);
  }

  .approach__columns {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
  }

  .approach__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-5);
  }

  .approach__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-3);
    margin-top: var(--space-10);
  }

  /* From a tablet up, the portrait sits beside the introduction, and the
     approach beside its heading, with its text kept to a readable measure. */
  @media (min-width: 48rem) {
    .about {
      grid-template-columns: 1fr 1fr;
    }

    /* Level with the top of the eyebrow's capitals, not its line: they start
       0.385em down its 0.78rem text, below the space the font leaves above
       them. */
    .about__portrait {
      margin-top: calc(0.78rem * 0.385);
    }

    .about__intro,
    .approach__body {
      max-width: var(--measure-prose);
    }

    /* The text takes up to its measure, so it ends in line with the
       portrait, and the heading takes the rest. */
    .approach__columns {
      grid-template-columns: minmax(14rem, 1fr) minmax(0, var(--measure-prose));
      align-items: start;
    }
  }
</style>
