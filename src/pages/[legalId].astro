---
import { getCollection, render, type CollectionEntry } from "astro:content";
import LegalPage from "@/components/LegalPage.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";

export async function getStaticPaths() {
  return (await getCollection("legal")).map((entry) => ({
    params: { legalId: entry.id },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<"legal">;
}

const { entry } = Astro.props;
const { title, lead, draft } = entry.data;
const { Content } = await render(entry);
---

<BaseLayout title={title} description={lead}>
  <LegalPage title={title} lead={lead} draft={draft}>
    <Content />
  </LegalPage>
</BaseLayout>
