# Headers Cloudflare Pages adds to the site's pages and files (#220).
# They don't apply to responses from Pages Functions.
/*
  Strict-Transport-Security: max-age=31536000
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Built files are named by their contents, so a changed file gets a new name,
# and they can be cached for a year without checking with the server.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
